/* pages/mine/mine.wxss —— 我的
   复用 app.wxss：.container / .card / .card--flush / .row / .truncate / .clamp2 /
   .title-md / .muted / .faint / .pressable。这里只写本页独有的 mn-* 语义类。
   注意：.container 上不能出现 transform（会让页内 fixed 元素退化），本文件没有。 */

/* ---------------- 全站搜索入口 ----------------
   长得像搜索框、实际是个跳转入口。刻意不做成真输入框：
   结果要按课程 / 论坛 / 闲置 / 活动 / 同学分组，在当前页原地展开会把这一屏撑爆，
   而「点了没反应」的输入框比一个明确的入口更让人困惑。 */
.mn-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 84rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
}
.mn-search--hover { background: var(--c-sunken); }
.mn-search__icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.mn-search__ph {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sub);
  color: var(--c-faint);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------------- 顶部渐变个人区 ---------------- */
.mn-hero {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx 28rpx;
  border-radius: var(--r-xl);
  /* 个人资料青蓝 → 主色，和 Web 版 MineHomeView 的渐变一致 */
  background: linear-gradient(135deg, var(--c-hero-from) 0%, var(--c-hero-to) 100%);
  box-shadow: 0 12rpx 32rpx var(--c-shadow-brand);
}
.mn-hero--hover { opacity: 0.88; }

.mn-hero__row { display: flex; align-items: center; gap: 24rpx; }

.mn-hero__avatar {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.35);
  overflow: hidden;
}
.mn-hero__avatar-img { width: 132rpx; height: 132rpx; }
.mn-hero__avatar-text {
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  text-align: center;
  font-size: var(--fs-hero);
  font-weight: 700;
  color: var(--c-on-strong);
}

.mn-hero__main { flex: 1; min-width: 0; }
.mn-hero__name-row { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.mn-hero__name {
  min-width: 0;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--c-on-strong);
  line-height: 1.3;
}
.mn-hero__badge {
  flex-shrink: 0;
  font-size: var(--fs-micro);
  line-height: 1.5;
  padding: 2rpx 16rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.2);
  color: var(--c-on-strong);
}
.mn-hero__line { margin-top: 8rpx; font-size: var(--fs-aux); color: rgba(255, 255, 255, 0.78); }
.mn-hero__line--sub { color: rgba(255, 255, 255, 0.62); }

.mn-hero__go { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.mn-hero__edit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  min-height: var(--hit-sm);
  margin-top: 28rpx;
  padding: 0 40rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.16);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.18);
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-on-strong);
}

.mn-page { padding-top: 8rpx; }

/* ---------------- 头像昵称提示 ---------------- */
.mn-tip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--c-amber-soft);
  border: 2rpx solid #f4e3b4;
}
.mn-tip--hover { opacity: 0.72; }
.mn-tip__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.mn-tip__text { flex: 1; min-width: 0; }
.mn-tip__title { font-size: var(--fs-body); font-weight: 600; color: #633806; }
.mn-tip__sub { margin-top: 4rpx; font-size: var(--fs-tag); color: #854f0b; line-height: 1.6; }

/* ---------------- 三个数字卡：点一下进对应的列表页 ----------------
   卡片自带 .pressable，按下要有即时反馈 —— 否则点完到页面跳过去之间的
   那半秒里，用户会以为没点上 */
.mn-stats { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.mn-stat {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  padding: 24rpx 16rpx;
  text-align: center;
  /* 数字卡里的红点要贴右上角（见 .mn-dot--stat）。
     加这一行只是为了给绝对定位找参照，卡片自己不带定位语义、对外层无影响 */
  position: relative;
}
.mn-stat--hover { opacity: 0.72; }
.mn-stat__num { font-size: var(--fs-stat); font-weight: 700; line-height: 1.15; }
/* 标签后面跟一枚小箭头 —— 这是「这张卡点得动」的唯一信号：
   它和上面那块天气卡长得几乎一样，没有箭头就没人会去点 */
.mn-stat__label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin-top: 8rpx;
  font-size: var(--fs-tag);
  color: var(--c-muted);
}
.mn-stat__go { width: 20rpx; height: 20rpx; flex-shrink: 0; }

/* ---------------- 入口行 ---------------- */
.mn-rows { margin-bottom: 24rpx; }
.mn-row--hover { background: var(--c-sunken); }

.mn-ico {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: var(--r-l);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mn-ico__img { width: 36rpx; height: 36rpx; }
.mn-ico--brand { background: var(--c-brand-soft); }
.mn-ico--campus { background: var(--c-campus-soft); }
.mn-ico--forum { background: var(--c-forum-soft); }
.mn-ico--slate { background: var(--c-fill); }

.mn-row__main { flex: 1; min-width: 0; }
.mn-row__title { font-size: var(--fs-body); font-weight: 600; color: var(--c-text); line-height: 1.4; }
.mn-row__desc { margin-top: 4rpx; font-size: var(--fs-tag); color: var(--c-muted); line-height: 1.5; }
.mn-row__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* 触感反馈那行的 switch：原生开关是按 51×31px 画的，放在 88rpx 的行里偏大，
   缩到 0.82 才跟右侧箭头同一个视觉重量。transform 只作用在这一行，
   不涉及带 fixed 子元素的容器，不会破坏有条件定位的元素。 */
.mn-switch { flex-shrink: 0; transform: scale(0.82); transform-origin: right center; }

/* 入口行尾的小红点（私信有未读 / 有待处理的申请）。
   数量已经写在下一行的描述里了，这里只给一个「有」的信号，所以不做数字、不做动效。
   底色跟会话列表的 .cs-dot 保持一致，两处红点看上去是同一个东西 */
.mn-dot {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--c-danger);
}
/* 贴在「我的帖子」数字卡右上角：帖子列表在页面很靠下的位置，
   不在这儿给一个信号，「有人回我了」得滑到底才看得见 */
.mn-dot--stat {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
}

/* ---------------- 评价与帖子列表 ----------------
   两份列表已搬到 pages/mine/reviews 与 pages/mine/posts，
   它们那一整套（卡片行、星级、板块标签、删除按钮、恢复横幅）的样式也跟着过去了。
   留在这里只会变成没人再引用、却每次都被打进主包的死代码。 */

/* ---------------- 身份警示条 ---------------- */
.mn-alert {
  margin-bottom: 8rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--r-xl);
  background: var(--c-danger-soft);
  border: 2rpx solid #f8d5d7;
}
.mn-alert--hover { opacity: 0.72; }
.mn-alert__title { font-size: var(--fs-body); font-weight: 600; color: var(--c-danger); }
.mn-alert__hint { margin-top: 8rpx; font-size: var(--fs-tag); color: #a8606a; line-height: 1.6; }

/* ---------------- 页脚 ---------------- */
.mn-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 0 8rpx;
}
.mn-foot__icon { width: 28rpx; height: 28rpx; }
