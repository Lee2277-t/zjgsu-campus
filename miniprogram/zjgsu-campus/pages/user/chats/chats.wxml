<!-- pages/user/chats —— 私信会话列表。
     时间/未读/首字这些展示字段全在 JS 里算好，模板只负责摆，这里不动任何逻辑。
     下拉刷新（enablePullDownRefresh + onPullDownRefresh）原样保留。 -->
<page-meta page-style="{{themeStyle}}" />
<app-header title="私信" showBack />

<view class="container cs">
  <!-- 顶部快捷入口：找同学 / 申请列表，任何时候都能找到这两个功能 -->
  <view class="cs-actions">
    <base-button block variant="ghost" size="sm" bindtap="goFind">找同学</base-button>
    <base-button block variant="ghost" size="sm" bindtap="goRequests">申请列表</base-button>
  </view>
  <!-- 骨架屏：用 app.wxss 的 .skeleton 语义类 -->
  <view wx:if="{{loading}}" class="card cs-sk">
    <view class="cs-sk-row">
      <view class="skeleton cs-sk-avatar"></view>
      <view class="cs-sk-body">
        <view class="skeleton cs-sk-line cs-sk-line--short"></view>
        <view class="skeleton cs-sk-line cs-sk-line--mid"></view>
      </view>
    </view>
    <view class="cs-sk-row">
      <view class="skeleton cs-sk-avatar"></view>
      <view class="cs-sk-body">
        <view class="skeleton cs-sk-line cs-sk-line--short"></view>
        <view class="skeleton cs-sk-line cs-sk-line--mid"></view>
      </view>
    </view>
  </view>

  <block wx:else>
    <!-- 云端查询失败 / 没响应：必须和「真的没有会话」分开显示。
         都显示成空列表的话，用户会以为自己的聊天记录被清空了 ——
         这种误解会让人做出「重新加一遍好友」这类多余动作 -->
    <view wx:if="{{degraded || offline}}" class="card cs-warn" bindtap="load">
      <image class="cs-warn__icon" src="/assets/icons/info--muted.svg" mode="aspectFit" />
      <text class="cs-warn__text">{{offline ? '云端没响应，这次没拉到会话列表。点这里重试' : '会话列表这次没拉到（是查询失败，不是没有会话）。点这里重试'}}</text>
    </view>

    <!-- 消息请求箱：还不是好友、对方先开口、我从来没回过的那批。
         默认收起 —— 默认展开的话，一条陌生人的广告会永远占住列表第一屏，
         那正是要避免的事。收起时用数字告诉用户「有几条」 -->
    <view wx:if="{{requestTotal}}" class="card card--flush cs-req">
      <view class="cs-req__head tap" bindtap="toggleRequests">
        <image class="cs-req__icon" src="/assets/icons/inbox--faint.svg" mode="aspectFit" />
        <text class="cs-req__title">消息请求</text>
        <text class="cs-req__count">{{requestTotal}}</text>
        <text class="cs-req__toggle">{{showRequests ? '收起' : '展开'}}</text>
      </view>

      <view wx:if="{{showRequests}}" class="cs-req__body">
        <view wx:for="{{requests}}" wx:key="peer" class="cs-req__item">
          <view class="cs-req__top tap" data-peer="{{item.peer}}" data-name="{{item.nickName}}" bindtap="openChat">
            <view class="cs-avatar-wrap">
              <image wx:if="{{item.avatarUrl && !avaErr[item.peer]}}" class="cs-avatar" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onAvaError" data-peer="{{item.peer}}" />
              <view wx:else class="cs-avatar cs-avatar--text">{{item.avatarText}}</view>
              <view wx:if="{{item.unread}}" class="cs-dot"></view>
            </view>
            <view class="cs-main">
              <view class="cs-top">
                <text class="cs-name truncate">{{item.nickName}}</text>
                <text class="cs-time">{{item.timeText}}</text>
              </view>
              <view class="cs-last truncate">{{item.lastTextCut}}</view>
            </view>
          </view>
          <!-- 两个按钮都用 catchtap：不 catch 会连带触发上面整行的 bindtap，
               跳进会话页，按钮按了个寂寞 -->
          <view class="cs-req__acts">
            <view class="cs-req__btn cs-req__btn--ghost tap" data-peer="{{item.peer}}" catchtap="onDismissReq">忽略</view>
            <view class="cs-req__btn tap" data-peer="{{item.peer}}" catchtap="onAcceptReq">接受</view>
          </view>
        </view>
        <!-- 请求箱在页面最上面，触底永远轮不到它，所以分页只能靠这个按钮 -->
        <view wx:if="{{requestHasMore}}" class="cs-req__more tap" bindtap="loadMoreReq">
          {{loadingMore ? '加载中…' : '加载更多请求'}}
        </view>
      </view>
    </view>

    <block wx:if="{{list.length === 0}}">
      <empty-state icon="message-circle" iconColor="faint"
        title="还没有和同学聊过天" description="遇到合得来的同学，打个招呼认识一下" />
    </block>

    <block wx:else>
      <view class="card card--flush cs-list">
        <view
          wx:for="{{list}}"
          wx:key="peer"
          class="cs-item tap"
          data-peer="{{item.peer}}"
          data-name="{{item.nickName}}"
          bindtap="openChat"
          bindlongpress="onLongPress"
        >
          <view class="cs-avatar-wrap">
            <image wx:if="{{item.avatarUrl && !avaErr[item.peer]}}" class="cs-avatar" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onAvaError" data-peer="{{item.peer}}" />
            <view wx:else class="cs-avatar cs-avatar--text">{{item.avatarText}}</view>
            <view wx:if="{{item.unread}}" class="cs-dot"></view>
          </view>
          <view class="cs-main">
            <view class="cs-top">
              <text class="cs-name truncate">{{item.nickName}}</text>
              <!-- 还不是好友的会话要标出来：这类对话有 3 条上限、对方也未必愿意聊，
                   不标的话用户点进去才发现发不出消息，看着像坏了 -->
              <text wx:if="{{!item.isFriend}}" class="cs-tag">非好友</text>
              <text class="cs-time">{{item.timeText}}</text>
            </view>
            <view class="cs-last truncate">{{item.lastTextCut}}</view>
          </view>
        </view>
      </view>

      <!-- 长按删除是微信里的通用手势，但没有任何视觉提示时新用户不会去试。
         一句话的说明比加一排删除按钮便宜得多 -->
      <view class="cs-note">长按会话可以删除</view>
      <view wx:if="{{hasMore}}" class="cs-more tap" bindtap="loadMore">
        {{loadingMore ? '加载中…' : '加载更多'}}
      </view>
    </block>
  </block>
</view>
