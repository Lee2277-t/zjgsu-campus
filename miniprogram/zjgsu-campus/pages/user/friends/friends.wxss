/* pages/user/friends —— 我的同学。类名统一 fr-*，
   .card / .segmented / .chip / .search-bar / .muted 等语义类来自 app.wxss，这里不重复。 */

.fr-tabs { margin-bottom: 24rpx; }

/* ---------- 刷新状态 / 云端不可用的软提示 ---------- */
.fr-sync {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 16rpx;
  font-size: var(--fs-tag);
  color: var(--c-faint);
}
.fr-sync__icon { width: 24rpx; height: 24rpx; }

.fr-offline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-amber-soft);
  border: 2rpx solid #ffe1a6;
  color: var(--c-amber-deep);
  font-size: var(--fs-aux);
  line-height: 1.6;
}
.fr-offline__icon { width: 30rpx; height: 30rpx; flex-shrink: 0; }

/* ---------- 同学行 ---------- */
.fr-person {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 0;
}

.fr-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-pill);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-on-strong);
  font-size: var(--fs-title);
  font-weight: 600;
  background: linear-gradient(135deg, var(--c-profile), var(--c-brand));
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.18);
  overflow: hidden;
}
.fr-avatar-img { width: 100%; height: 100%; border-radius: var(--r-pill); }
.fr-avatar--blocked { background: var(--c-fill); color: var(--c-faint); box-shadow: none; }

.fr-info {
  flex: 1;
  min-width: 0;
}

.fr-name {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--c-text);
}
.fr-college {
  font-size: var(--fs-aux);
  color: var(--c-muted);
  font-weight: 400;
  margin-left: 8rpx;
}
.fr-contact {
  font-size: var(--fs-aux);
  color: var(--c-profile);
  margin-top: 8rpx;
}

/* 备注名下面那行「原名」。字号更小、颜色更淡：
   它是给「这是谁来着」兜底的，不该盖过备注名本身 */
.fr-alias {
  font-size: var(--fs-tag);
  color: var(--c-faint);
  margin-top: 4rpx;
}

/* 名单行右侧的关系标记（已拉黑 / 也是同学）。
   中性灰底、不抢注意力 —— 它是状态说明，不是需要用户处理的异常 */
.fr-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-fill);
  color: var(--c-muted);
  font-size: var(--fs-micro);
  line-height: 1.6;
}
/* 「已拉黑」用暖色：它意味着一部分功能已经被自己关掉了，
   和「也是同学」这种纯说明不是一个性质 */
.fr-tag--warn {
  background: #fff6e8;
  color: #b8791f;
}

/* 「申请」页签里两个方向的分组标题 */
.fr-sec {
  margin: 8rpx 8rpx 16rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-text);
}
.fr-sec--gap { margin-top: 40rpx; }

/* 分组内的空态：这里刻意不用 empty-state ——
   一个页签里塞两张大插画会让人以为整页都空了 */
.fr-none {
  margin: 0 8rpx 24rpx;
  font-size: var(--fs-aux);
  color: var(--c-faint);
  line-height: 1.7;
}

.fr-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* ---------- 名单行里的行内动作：加好友 / 解除 ----------
   刻意不用 .fr-op（那是请求卡片上「整行平分」的按钮，flex:1 会把这一行撑开），
   也不改 base-button 的默认尺寸 —— 名单行里需要的是「贴着右端的小胶囊」 */
.fr-act {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-sub);
  font-weight: 600;
}
.fr-act--primary { background: var(--c-brand-soft); color: var(--c-brand-deep); border: 2rpx solid #dce7ff; }
.fr-act--danger { background: var(--c-danger-soft); color: var(--c-danger); }

/* 已是同学 / 已申请：只给状态，不给可点的东西 */
.fr-state {
  flex-shrink: 0;
  font-size: var(--fs-aux);
  color: var(--c-faint);
}

/* ---------- 请求 / 黑名单里的操作按钮 ---------- */
.fr-req { padding-bottom: 8rpx; }

.fr-ops {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 20rpx;
}
.fr-op { flex: 1; min-width: 0; }

/* ---------- 搜索 ---------- */
.fr-search { margin-bottom: 16rpx; }
.fr-search-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.fr-search-input { flex: 1; min-width: 0; font-size: var(--fs-body); }
.fr-do {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 88rpx;
  padding-left: 20rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-profile);
}

.fr-modes { margin-bottom: 8rpx; }

/* ---------- 提示 ---------- */
.fr-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 4rpx 0 24rpx;
  font-size: var(--fs-tag);
  color: var(--c-muted);
  line-height: 1.7;
}
.fr-tip--top { margin: 0 0 16rpx; }
.fr-tip-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 8rpx;
}

/* ---------- 底部入口 ---------- */
.fr-more { margin-top: 8rpx; }
