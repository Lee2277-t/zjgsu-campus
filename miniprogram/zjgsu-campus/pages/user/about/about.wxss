/* pages/user/about —— 关于。类名统一 ab-*，
   .card / .container 来自 app.wxss。阴影与圆角沿用设计令牌。 */

.ab { padding-bottom: 60rpx; }

.ab-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 44rpx;
  margin-bottom: 24rpx;
}
.ab-logo {
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--r-xl);
  overflow: hidden;
  background: var(--c-card);
  box-shadow: 0 12rpx 32rpx rgba(43, 90, 237, 0.16);
}
.ab-logo-img { width: 100%; height: 100%; }
.ab-name {
  margin-top: 24rpx;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--c-text);
}
.ab-sub {
  margin-top: 8rpx;
  font-size: var(--fs-aux);
  color: var(--c-muted);
}
.ab-ver {
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand-soft);
  color: var(--c-brand);
  font-size: var(--fs-tag);
}

.ab-sec {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.ab-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}
.ab-row:last-of-type { border-bottom: none; }
.ab-row--tap:active { opacity: 0.7; }
.ab-row__k {
  font-size: var(--fs-sub);
  color: var(--c-muted);
}
.ab-row__v {
  font-size: var(--fs-sub);
  color: var(--c-text);
  max-width: 62%;
  text-align: right;
  word-break: break-all;
}
.ab-row__v--warn { color: var(--c-danger); font-weight: 600; }
.ab-row__v--link { color: var(--c-brand); }

.ab-warn {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.ab-feats { margin-top: 24rpx; }
.ab-feats__t {
  font-size: var(--fs-aux);
  color: var(--c-faint);
  margin-bottom: 12rpx;
}
.ab-feats__list {
  display: flex;
  flex-wrap: wrap;
}
.ab-feat {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-sunken);
  color: var(--c-muted);
  font-size: var(--fs-tag);
}

.ab-btn { margin-top: 24rpx; }

.ab-p {
  font-size: var(--fs-sub);
  line-height: 1.85;
  color: var(--c-muted);
  margin-bottom: 16rpx;
}
.ab-p:last-child { margin-bottom: 0; }
.ab-p--sm { font-size: var(--fs-aux); }
.ab-strong { color: var(--c-text); font-weight: 600; }
