/* pages/user/chat —— 私聊详情页。类名统一 ct-*。
   硬性约束：.ct / .ct-body / .ct-bar 上都不允许出现 transform，
   否则 position:fixed 的底部输入栏会退化成相对定位。 */
/* 整页高度走百分比：vh 是视口单位，这里全部用 rpx/百分比闭环，尺寸一律 rpx。
   改成纵向 flex：app-header 是普通流里的第一项，剩下的高度全给 .ct。
   —— 以前是 .ct{height:100%}，而 100% 是**整屏**高，上面还压着自定义导航条，
     于是 .ct 的底部被顶到屏幕外面，输入栏跟着沉下去，视觉上就是「断层」。 */
page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.ct {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  background: var(--c-bg);
  /* 「N 条新消息」角标要绝对定位在输入栏正上方：定位基准放在这里，
     挂在滚动的 .ct-body 里的话角标会跟着内容一起滚走 */
  position: relative;
}

.ct-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 给 fixed 输入栏让位：高度 = 输入栏高度 + 一点呼吸空间。
   输入栏本身带 env(safe-area-inset-bottom) 的内边距（iPhone 底部小横条），
   这里必须加上同样的量，否则全面屏上最后一句话会被小横条压掉一截 */
.ct-bottom-space {
  flex-shrink: 0;
  height: calc(200rpx + env(safe-area-inset-bottom));
}
/* 待发缩略图条展开时输入栏更高，底部留白同步加高，免得最后一条被盖住 */
.ct-bottom-space--tall {
  height: calc(380rpx + env(safe-area-inset-bottom));
}
/* 锁块比输入行高一截（说明文字 + 按钮），占位不跟着加高，
   最后一句话会被 fixed 的输入栏盖住 —— 而且是「刚好差一点点」的那种，
   看着像渲染错位而不是被挡住 */
.ct-bottom-space--lock {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

.ct-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 60rpx 0;
  font-size: var(--fs-aux);
  color: var(--c-faint);
}
.ct-tip-icon { width: 28rpx; height: 28rpx; }

.ct-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 60rpx 40rpx;
  font-size: var(--fs-aux);
  color: var(--c-faint);
  text-align: center;
}
.ct-notice-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }

/* ---------- 消息 ---------- */
.ct-row {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 32rpx;
}
.ct-row--mine { justify-content: flex-end; }

.ct-msg {
  max-width: 76%;
  min-width: 0;
}

.ct-bubble {
  background: var(--c-card);
  color: var(--c-text);
  font-size: var(--fs-body);
  line-height: 1.6;
  padding: 20rpx 28rpx;
  border-radius: var(--r-xl);
  border-top-left-radius: var(--r-s);
  word-break: break-word;
}
/* 自己发的：个人资料青蓝 #2F9FD6 */
.ct-bubble--mine {
  background: var(--c-profile);
  color: var(--c-on-strong);
  border-top-left-radius: var(--r-xl);
  border-top-right-radius: var(--r-s);
}
.ct-bubble--failed {
  background: var(--c-danger-soft);
  color: var(--c-danger);
}

/* ---------- 消息里的配图 ----------
   1 张给大图，2–3 张并排，4 张以上三列网格。
   刻意不给单图铺满：铺满整屏会把对话节奏挤没，翻消息变成翻相册 */
.ct-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  max-width: 480rpx;
}
/* 圆角 / 占位色跟详情页 .detail__img 保持一致（--r-l + --c-fill）。
   尺寸不统一是刻意的：气泡里的图要跟着消息条数变，1 张给大图、4 张以上收成三列，
   硬套 200rpx 会让单图消息小得像缩略图。相同的是"质感"，不是"尺寸"。 */
.ct-img {
  border-radius: var(--r-l);
  background: var(--c-fill);
}
.imgs-1 .ct-img { width: 360rpx; height: 360rpx; }
.imgs-2 .ct-img,
.imgs-3 .ct-img { width: 200rpx; height: 200rpx; }
.imgs-many .ct-img { width: 152rpx; height: 152rpx; }
/* 图文混排时气泡和图片之间留一口气，不然贴在一起像一张图 */
.ct-imgs + .ct-bubble { margin-top: 12rpx; }

/* 未送达时的重发入口（图片消息没有气泡，按钮挂在时间行下面） */
.ct-retry {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  font-size: var(--fs-tag);
  font-weight: 600;
}
.ct-row--mine .ct-retry { float: right; }

.ct-clock {
  font-size: var(--fs-micro);
  color: var(--c-faint);
  margin-top: 8rpx;
  text-align: left;
}
.ct-row--mine .ct-clock { text-align: right; }

/* ---------- 系统消息 ----------
   「你们已解除同学关系，聊天记录保留…」这类不是任何一方说的话，
   所以不给气泡、不靠左也不靠右，而是居中一小行灰字。
   做成气泡会被读成「对方刚说了这句」，而它其实谁都没说 */
.ct-sys {
  display: flex;
  justify-content: center;
  margin: 8rpx 0 32rpx;
}
.ct-sys__text {
  max-width: 86%;
  padding: 12rpx 24rpx;
  border-radius: var(--r-m);
  background: var(--c-fill);
  color: var(--c-muted);
  font-size: var(--fs-tag);
  line-height: 1.6;
  text-align: center;
}

/* 撤回后的占位。保留在原位置（不是直接删掉那条），
   否则上下两句会接在一起，读起来像另一个人说的话 */
.ct-recalled {
  display: inline-block;
  padding: 16rpx 28rpx;
  border-radius: var(--r-xl);
  border-top-left-radius: var(--r-s);
  background: var(--c-fill);
  color: var(--c-faint);
  font-size: var(--fs-aux);
  font-style: italic;
}
.ct-row--mine .ct-recalled {
  border-top-left-radius: var(--r-xl);
  border-top-right-radius: var(--r-s);
}

/* ---------- 「N 条新消息」角标 ----------
   只在用户往上翻记录、同时有新消息到达时出现。
   bottom 与 .ct-bottom-space 同高：正好浮在输入栏上沿，不遮挡任何一条消息 */
.ct-newhint {
  position: absolute;
  right: 24rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom) + 16rpx);
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--c-profile);
  color: var(--c-on-strong);
  font-size: var(--fs-aux);
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.32);
}
/* 锁块比输入行高，角标要跟着让位，否则正好压在「申请加好友」按钮上 */
.ct-newhint--lock {
  bottom: calc(280rpx + env(safe-area-inset-bottom) + 16rpx);
}
.ct-newhint__arrow { font-size: var(--fs-aux); }

/* ---------- 消息请求条（陌生人先开口） ----------
   放在整页最上面：此刻唯一需要用户做的决定就是「收下还是忽略」。
   配色用中性的浅灰蓝而不是警告红 —— 陌生人发消息本身不是错误 */
.ct-req {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: var(--r-l);
  background: var(--c-fill);
}
.ct-req__text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ct-req__title {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-text);
}
.ct-req__sub {
  font-size: var(--fs-tag);
  color: var(--c-muted);
  line-height: 1.6;
}
.ct-req__acts {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.ct-req__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: var(--r-pill);
  background: var(--c-profile);
  color: var(--c-on-strong);
  font-size: var(--fs-sub);
  font-weight: 600;
}
/* 「忽略」是次级动作：不给实心底色，免得两个按钮抢注意力点错 */
.ct-req__btn--ghost {
  background: var(--c-card);
  color: var(--c-muted);
  font-weight: 500;
}

/* ---------- 查看对方名片条 ---------- */
.ct-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-card);
  color: var(--c-profile);
  font-size: var(--fs-aux);
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.08);
}
.ct-card-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.ct-card-title { flex: 1; min-width: 0; }
.ct-card-arrow { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* ---------- 已拉黑提示条 ---------- */
.ct-blocked-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  font-size: var(--fs-aux);
}
.ct-blocked-tip__icon { width: 30rpx; height: 30rpx; flex-shrink: 0; }

/* 还不是好友的额度提示。用品牌青蓝而不是红色 ——
   这不是出错，只是「你们的关系还没到那一步」，红色会让人以为自己操作错了 */
.ct-quota-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-profile-soft);
  color: var(--c-profile);
  font-size: var(--fs-aux);
  line-height: 1.6;
}
.ct-quota-tip__icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* ---------- 发不出去时替换掉整个输入行 ---------- */
.ct-lock {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.ct-lock__text {
  font-size: var(--fs-aux);
  color: var(--c-muted);
  line-height: 1.7;
}
.ct-lock__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--r-pill);
  background: var(--c-profile);
  color: var(--c-on-strong);
  font-size: var(--fs-body);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.24);
}
.ct-lock__wait {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--r-pill);
  background: var(--c-fill);
  color: var(--c-muted);
  font-size: var(--fs-sub);
}

/* ---------- 对方的联系方式条 ---------- */
.ct-contact {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-profile-soft);
  color: var(--c-profile);
  font-size: var(--fs-aux);
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.08);
}
.ct-contact-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.ct-contact-copy {
  flex-shrink: 0;
  font-weight: 600;
  color: var(--c-brand);
}

/* ---------- 固定输入栏 ----------
   .fixed-bar 只给了 position/left/right/z-index，**没有 bottom**。
   position:fixed 的 top/bottom 都是 auto 时，元素停在「原本在流里的位置」——
   而它在 .ct 的最后，那个位置已经跑到屏幕外面去了，输入栏于是半沉在屏幕下沿，
   这就是「聊天窗口出现断层」的根因。这里显式贴底。
   结构改成上下两行：第一行是待发缩略图（有图时才出现），第二行才是输入行 */
.ct-bar {
  display: flex;
  flex-direction: column;
  bottom: 0;
  background: var(--c-card);
  border-top: 2rpx solid var(--c-line);
}

.ct-bar__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

/* 选图按钮：和输入框等高，热区 ≥ 88rpx，别让人点不准 */
.ct-pick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: var(--r-pill);
  background: var(--c-brand-soft);
}
.ct-pick-icon { width: 40rpx; height: 40rpx; }

/* GIF 入口：比选图窄一档，但保持 88rpx 高度，避免挤压输入框 */
.ct-gif {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: var(--r-pill);
  background: var(--c-brand-soft);
  color: var(--c-brand);
  font-size: var(--fs-micro);
  font-weight: 600;
}

/* ---------- 待发送的图片条 ---------- */
.ct-pending {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
}
.ct-pending__item {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}
.ct-pending__img {
  width: 100%;
  height: 100%;
  border-radius: var(--r-m);
  background: var(--c-line);
}
/* 移除按钮：视觉 40rpx，热区撑到 64rpx，手指够得着 */
.ct-pending__x {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}
.ct-pending__x-icon {
  width: 40rpx;
  height: 40rpx;
  padding: 8rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--sh-4);
  box-sizing: border-box;
}
.ct-pending__loading {
  flex: 1;
  min-width: 160rpx;
  font-size: var(--fs-tag);
  color: var(--c-brand);
}

.ct-input {
  flex: 1;
  min-width: 0;
  /* 定高修复：单行显示，字不会被默认行高切一半；88rpx 起保证点得到 */
  height: 88rpx;
  max-height: 180rpx;
  padding: 0 28rpx;
  border-radius: var(--r-pill);
  background: var(--c-sunken);
  font-size: var(--fs-body);
  color: var(--c-text);
}

.ct-send {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  min-width: 140rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  flex-shrink: 0;
  border-radius: var(--r-pill);
  background: var(--c-profile);
  color: var(--c-on-strong);
  font-size: var(--fs-sub);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.24);
}
.ct-send-icon {
  width: 28rpx;
  height: 28rpx;
}

.ct-bubble__text { white-space: pre-wrap; word-break: break-word; }
