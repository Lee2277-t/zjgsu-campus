/* pages/user/guide —— 应用说明。类名统一 gd-*，
   .card / .title-lg / .muted / .bg-brand-50 / .bg-profile-soft 来自 app.wxss。 */

/* ---------- 顶部渐变：个人资料青蓝 #2F9FD6 → 主色 #2B5AED ---------- */
.gd-hero {
  padding: 28rpx 40rpx 44rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-xl);
  background: linear-gradient(160deg, var(--c-profile) 0%, var(--c-brand) 100%);
  box-shadow: 0 12rpx 32rpx rgba(47, 159, 214, 0.22);
}
.gd-hero-title {
  color: var(--c-on-strong);
}
.gd-hero-sub {
  margin-top: 12rpx;
  font-size: var(--fs-sub);
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.7;
}
.gd-hero-date {
  margin-top: 12rpx;
  font-size: var(--fs-tag);
  color: rgba(255, 255, 255, 0.66);
}

.gd-sec {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 20rpx;
}

/* ---------- 五个底部标签 ---------- */
.gd-block {
  padding-bottom: 28rpx;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid var(--c-line);
}
.gd-block:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.gd-tab-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.gd-tab-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-l);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gd-tab-icon-img { width: 44rpx; height: 44rpx; }

.gd-tab-text {
  flex: 1;
  min-width: 0;
}
.gd-tab-name {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--c-text);
  flex-shrink: 0;
}
/* 模块说明允许换行，不加 truncate —— 全文才 300 字，截断掉反而读不全 */
.gd-mod-desc {
  font-size: var(--fs-sub);
  color: var(--c-muted);
  line-height: 1.7;
}

/* ---------- 应用简介：一整段话，不做项目符号 ---------- */
.gd-para {
  font-size: var(--fs-body);
  color: var(--c-text);
  line-height: 1.75;
}

/* ---------- 说明行 ---------- */
.gd-line {
  position: relative;
  padding-left: 24rpx;
  font-size: var(--fs-sub);
  color: var(--c-muted);
  line-height: 1.75;
}
/* 小圆点当项目符号，比手打「·」稳，换行也不会错位 */
.gd-line::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 20rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--r-pill);
  background: #c3d3ea;
}

.gd-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 20rpx 20rpx;
  border-radius: var(--r-l);
  background: var(--c-market-soft);
  font-size: var(--fs-aux);
  color: var(--c-market-deep);
  line-height: 1.7;
}
.gd-note-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 8rpx;
}

/* ---------- 提醒卡 ---------- */
.gd-warn { background: var(--c-amber-soft); }
.gd-line--warn { color: #8a6d1a; }
.gd-line--warn::before { background: #e8b869; }
