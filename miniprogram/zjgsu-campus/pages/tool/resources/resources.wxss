/* pages/tool/resources/resources.wxss —— 学习资料
   复用 app.wxss：.container / .card / .card--flat / .muted / .faint / .clamp2 /
   .search-bar / .chip / .chip-on / .chip-row / .truncate。本页独有全部是 rs-*。 */

.rs-page { padding-top: 8rpx; }
.rs-loading { padding: 60rpx 0; text-align: center; font-size: var(--fs-sub); color: var(--c-faint); }

/* ---------------- 搜索 ---------------- */
.rs-search { margin-bottom: 20rpx; }
.rs-search__icon { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.rs-search__input { height: 88rpx; }
.rs-search__ph { color: var(--c-faint); }

.rs-cats { margin: 4rpx 0 20rpx; }

/* ---------------- 分享入口 ---------------- */
.rs-share { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.rs-share--hover { opacity: 0.72; }
.rs-share__ico {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: var(--r-l);
  background: var(--c-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rs-share__ico-img { width: 40rpx; height: 40rpx; }
.rs-share__main { flex: 1; min-width: 0; }
.rs-share__title { font-size: var(--fs-body); font-weight: 600; color: var(--c-text); }
.rs-share__sub { margin-top: 4rpx; font-size: var(--fs-tag); line-height: 1.5; }
.rs-share__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* ---------------- 上传表单 ---------------- */
.rs-form { padding-bottom: 28rpx; }

.rs-file {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-sunken);
}
.rs-file--hover { opacity: 0.72; }
.rs-file__ico {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: var(--r-l);
  background: var(--c-card);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rs-file__ico-img { width: 36rpx; height: 36rpx; }
.rs-file__main { flex: 1; min-width: 0; }
.rs-file__name { font-size: var(--fs-sub); color: var(--c-text); }
.rs-file__sub { margin-top: 4rpx; font-size: var(--fs-tag); }
.rs-file__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* 待发队列：一份一行，标题可改 */
.rs-qhead {
  margin-top: 20rpx;
  font-size: var(--fs-tag);
  color: var(--c-muted);
}
.rs-qitem {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  height: 88rpx;
  border-radius: var(--r-l);
  background: var(--c-sunken);
}
.rs-qitem__ico { width: 32rpx; height: 32rpx; flex-shrink: 0; }
/* input 撑满剩余宽度：不定宽的话在窄屏上会被删除键挤没 */
.rs-qitem__input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--c-text);
}
.rs-qitem__del {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rs-qitem__x { width: 28rpx; height: 28rpx; }

/* input 必须定高，否则默认行高会把字拦腰截断 */
.rs-field {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  font-size: var(--fs-body);
  color: var(--c-text);
  background: var(--c-sunken);
  border-radius: var(--r-l);
}
.rs-types { margin: 8rpx 0 0; }
.rs-submit { margin-top: 24rpx; }

/* ---------------- 资料卡片 ---------------- */
.rs-item { margin-bottom: 20rpx; }

.rs-head { display: flex; align-items: flex-start; gap: 20rpx; }
.rs-head__ico {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: var(--r-l);
  background: var(--c-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rs-head__ico-img { width: 40rpx; height: 40rpx; }
.rs-main { flex: 1; min-width: 0; }
.rs-title { font-size: var(--fs-h2); font-weight: 600; color: var(--c-text); line-height: 1.45; }
.rs-meta { margin-top: 8rpx; font-size: var(--fs-aux); }
.rs-desc { margin-top: 8rpx; font-size: var(--fs-aux); line-height: 1.6; }

.rs-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--c-fill);
}
.rs-by { flex-shrink: 1; min-width: 0; font-size: var(--fs-tag); }
.rs-ops { flex-shrink: 0; display: flex; gap: 8rpx; }

.rs-op {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: var(--hit-sm);
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-aux);
  color: var(--c-muted);
  background: var(--c-sunken);
}
.rs-op--hover { opacity: 0.72; }
.rs-op__icon { width: 30rpx; height: 30rpx; }
.rs-op--on { color: var(--c-campus-deep); background: var(--c-campus-soft); }
.rs-op--primary { color: var(--c-on-strong); background: var(--c-brand); }
.rs-op--danger { color: var(--c-danger); background: var(--c-danger-soft); }
/* ---------------- 审核员：待审核资料 ---------------- */
.rs-review { margin-bottom: 24rpx; }
.rs-review__head { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.rs-review__title { font-size: var(--fs-body); font-weight: 600; color: var(--c-text); }
.rs-review__sub { font-size: var(--fs-tag); }
.rs-review__empty { padding: 20rpx 0; font-size: var(--fs-sub); }
.rs-review__item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--c-fill);
}
.rs-review__main { flex: 1; min-width: 0; }
.rs-review__name { font-size: var(--fs-sub); font-weight: 600; color: var(--c-text); }
.rs-review__meta { margin-top: 8rpx; font-size: var(--fs-tag); }
.rs-review__desc { margin-top: 8rpx; font-size: var(--fs-tag); line-height: 1.5; }
.rs-review__ops { flex-shrink: 0; display: flex; flex-wrap: wrap; gap: 8rpx; justify-content: flex-end; }
.rs-form__note { margin-top: 16rpx; font-size: var(--fs-tag); }
.rs-status { margin-top: 8rpx; }
