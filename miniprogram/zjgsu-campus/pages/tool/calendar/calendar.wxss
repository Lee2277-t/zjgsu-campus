/* pages/tool/calendar/calendar.wxss —— 校历倒计时
   复用 app.wxss：.container / .card / .tag / .tag--campus / .title-sm / .muted /
   .faint / .clamp2 / .chip / .chip-on / .chip-row。本页独有全部是 cl-*。
   时间轴的竖线用伪元素画在 .cl-list 上，不用 transform。 */

.cl-page { padding-top: 8rpx; }
.cl-loading { padding: 60rpx 0; text-align: center; font-size: var(--fs-sub); color: var(--c-faint); }

/* ---------------- 顶部节点卡：青蓝 → 主色渐变 ---------------- */
.cl-next {
  padding: var(--sp-9) 32rpx 32rpx;
  background: linear-gradient(135deg, var(--c-profile) 0%, var(--c-brand) 100%);
  box-shadow: 0 12rpx 32rpx rgba(43, 90, 237, 0.2);
  color: var(--c-on-strong);
}
.cl-next__head { display: flex; align-items: center; gap: 12rpx; }
.cl-next__icon { width: 30rpx; height: 30rpx; }
.cl-next__label { font-size: var(--fs-aux); color: rgba(255, 255, 255, 0.82); }

.cl-next__count { display: flex; align-items: flex-end; margin-top: 20rpx; }
.cl-next__days { font-size: var(--fs-mega); font-weight: 700; line-height: 1; }
.cl-next__unit { margin-left: 12rpx; padding-bottom: 8rpx; font-size: var(--fs-sub); color: rgba(255, 255, 255, 0.85); }

.cl-next__name { margin-top: 16rpx; font-size: var(--fs-h2); font-weight: 600; line-height: 1.35; }
.cl-next__date {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.18);
  font-size: var(--fs-aux);
  color: var(--c-on-strong);
}
.cl-next__date--empty { background: rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.9); }

/* ---------------- 时间轴 ---------------- */
.cl-list { position: relative; padding: 8rpx 0 8rpx 44rpx; }
/* 竖线：绝对定位在列表左边缘，和圆点同一条中心线 */
.cl-list::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 32rpx;
  width: 4rpx;
  border-radius: var(--r-s);
  background: linear-gradient(180deg, var(--c-campus) 0%, var(--c-line) 100%);
}

.cl-node { position: relative; margin-bottom: 24rpx; }
.cl-node:last-child { margin-bottom: 0; }

.cl-node__dot {
  position: absolute;
  left: -40rpx;
  top: 40rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--c-campus);
  box-shadow: 0 0 0 6rpx #e9f8f1;
}
.cl-node__dot--past { background: var(--c-disabled); box-shadow: 0 0 0 6rpx var(--c-fill); }

.cl-item { padding: 24rpx 28rpx; }
.cl-item--past { background: #fbfcfe; }

.cl-item__main { flex: 1; min-width: 0; }
.cl-item__date { margin-top: 8rpx; font-size: var(--fs-aux); }
.cl-item__note { margin-top: 8rpx; line-height: 1.6; }
.cl-item--past .title-sm,
.cl-item--past .cl-item__date { color: var(--c-faint); }

.cl-item__side {
  flex-shrink: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.cl-del {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: var(--hit-sm);
  padding: 0 8rpx;
  font-size: var(--fs-aux);
  color: var(--c-danger);
}
.cl-del--hover { opacity: 0.6; }
.cl-del__icon { width: 30rpx; height: 30rpx; }

/* ---------------- 审核员编辑区 ---------------- */
.cl-mod { padding-top: 16rpx; }
.cl-mod__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
}
.cl-mod__head--hover { opacity: 0.72; }
.cl-mod__icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.cl-mod__title { flex: 1; min-width: 0; font-size: var(--fs-body); font-weight: 600; color: var(--c-brand-deep); }
.cl-mod__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* input / picker 定高：只给 padding 不给高度会把字拦腰截断 */
.cl-field {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
  font-size: var(--fs-body);
  color: var(--c-text);
  background: var(--c-sunken);
  border-radius: var(--r-l);
}
.cl-field--picker {
  display: flex;
  align-items: center;
  color: var(--c-brand-deep);
}
.cl-submit { margin-top: 24rpx; }

/* ---------------- 页脚说明 ---------------- */
.cl-foot {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 8rpx 16rpx;
}
.cl-foot__icon { width: 28rpx; height: 28rpx; flex-shrink: 0; margin-top: 8rpx; }
.cl-foot text { flex: 1; min-width: 0; font-size: var(--fs-tag); color: var(--c-faint); line-height: 1.7; }
