/* pages/forum/list/list.wxss —— 论坛信息流（tab 页，用原生导航条）
   只写本页面专用的语义类；通用令牌全部走 app.wxss。 */

/* --------------------------------------------------------------------------
   -------------------------------------------------------------------------- */
/* --------------------------------------------------------------------------
   搜索
   -------------------------------------------------------------------------- */
.search-bar { margin-bottom: 20rpx; }
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 8rpx 0 28rpx;
  border-radius: var(--r-pill);
  background: var(--c-card);
  box-shadow: var(--sh-1);
}
.search-box__icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.search-box__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: var(--fs-body);
  color: var(--c-text);
}
.search-box__clear {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.search-box__clear-icon { width: 32rpx; height: 32rpx; }
.search-box__go {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-brand-deep);
}

.search-panel { margin-bottom: 8rpx; }
.panel-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.panel-row--topic { margin-top: 12rpx; }
/* 最近搜索收起来时，热门话题就是面板第一行，不该再留 12rpx 的顶部余量 */
.panel-row--lead { margin-top: 0; }
.panel-label { font-size: var(--fs-aux); color: var(--c-muted); font-weight: 600; }
.panel-more { font-size: var(--fs-aux); color: var(--c-faint); }
.search-panel .filters { margin-bottom: 4rpx; }
/* 热门话题胶囊：论坛紫，和树洞入口同色系，扫一眼就知道这是论坛的内容 */
.topic-pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-aux);
  color: var(--c-forum);
  background: var(--c-forum-soft);
}
.topic-pill--empty { color: var(--c-faint); background: var(--c-sunken); }

.result-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.result-text { font-size: var(--fs-sub); color: var(--c-muted); }
.result-reset { font-size: var(--fs-sub); color: var(--c-brand-deep); }

/* --------------------------------------------------------------------------
   筛选 / 排序
   -------------------------------------------------------------------------- */
.filters { white-space: nowrap; margin-bottom: 20rpx; }
.filters .chip { margin-bottom: 8rpx; }
.course-filter { margin-bottom: 16rpx; }

.sort-seg { margin-bottom: 20rpx; }
.sort-seg .segmented {
  display: flex;
  background: var(--c-fill);
  border-radius: var(--r-pill);
  padding: 8rpx;
}
.sort-seg .segmented-item {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
  min-height: 88rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-micro);
  color: var(--c-muted);
  line-height: 1.2;
}
.sort-seg .segmented-item-on { font-weight: 600; }
.sort-seg__icon { width: 30rpx; height: 30rpx; }
.sort-seg__label { max-width: 100%; overflow: hidden; white-space: nowrap; }

/* --------------------------------------------------------------------------
   帖子卡
   -------------------------------------------------------------------------- */
@keyframes postIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* 只淡入，不动 transform：.container 有 transform 会让 .fab 掉出固定定位 */
.post-in { animation: postIn 0.28s ease-out both; }

.post__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 44rpx;
  margin-bottom: 12rpx;
}
.post__pin {
  flex-shrink: 0;
  font-size: var(--fs-micro);
  font-weight: 600;
  color: var(--c-on-strong);
  background: var(--c-danger);
  padding: 4rpx 16rpx;
  border-radius: var(--r-s);
}
.post__board { flex-shrink: 0; }
.post__topic,
.post__anon { flex-shrink: 0; }
.post__mini-icon { width: 24rpx; height: 24rpx; }
.post__rank {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  text-align: center;
  line-height: 36rpx;
  border-radius: var(--r-s);
  font-size: var(--fs-micro);
  font-weight: 700;
  color: var(--c-on-strong);
  background: #c0c6cc;
}
.post__rank--1 { background: #e64340; }
.post__rank--2 { background: #f0882e; }
.post__rank--3 { background: #f5b400; }
.post__score {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-tag);
  color: var(--c-market-deep);
  background: var(--c-market-soft);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
}
.post__time {
  margin-left: auto;
  flex-shrink: 0;
  font-size: var(--fs-tag);
  color: var(--c-faint);
}

.post__course {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand-soft);
  color: var(--c-brand-deep);
  font-size: var(--fs-aux);
}
.post__course-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.post__course-go { width: 26rpx; height: 26rpx; flex-shrink: 0; }

.post__title { margin-bottom: 8rpx; }
.post__content {
  color: var(--c-text);
  font-size: var(--fs-sub);
  line-height: 1.65;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post__content--hint { color: var(--c-faint); }

.search-hit { color: var(--c-danger); font-weight: 600; }

.post__images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 4rpx;
}
.post__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-l);
  background: var(--c-fill);
}

.post__foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--c-line);
}
/* 左边作者：太长截断，不许折行顶开右边操作区 */
.post__author {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-aux);
  color: var(--c-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 右边操作：整体右推，320 宽度下也不跟作者名重叠 */
.post__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.post__act {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 4rpx;
  font-size: var(--fs-aux);
  color: var(--c-muted);
}
.post__act-icon { width: 30rpx; height: 30rpx; }
.post__act--on { color: var(--c-brand-deep); font-weight: 600; }
.post__act--on .post__act-icon { width: 32rpx; height: 32rpx; }
.post__act--no { color: var(--c-campus-deep); font-weight: 600; }
.post__act--done { color: var(--c-faint); }
.post__act--text { padding: 0 4rpx; font-size: var(--fs-aux); }
/* 分享只允许点图标本身：外层固定 64rpx，并裁掉 button 的原生溢出热区，
   避免点帖子正文或操作行空白处也被 open-type=share 接走 */
.post__share-wrap {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--r-pill);
}
.post__share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  overflow: hidden;
  border-radius: var(--r-pill);
}
.post__share::after { border: none; }

/* .load-more 已提到 app.wxss（四个列表共用一份），这里不再保留私有定义 ——
   留着的话以后改全局那份时，论坛页会纹丝不动，最难查的那种不一致。 */

/* --------------------------------------------------------------------------
   断网提示
   -------------------------------------------------------------------------- */
.net-bar {
  background: var(--c-market-soft);
  color: var(--c-market-deep);
  font-size: var(--fs-aux);
  padding: 16rpx 24rpx;
  border-radius: var(--r-l);
  margin-bottom: 20rpx;
}

/* --------------------------------------------------------------------------
   首屏骨架屏
   -------------------------------------------------------------------------- */
.sk-wrap { margin-top: 8rpx; }
.sk-card {
  background: var(--c-card);
  border-radius: var(--r-xl);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: var(--r-m);
  background: linear-gradient(90deg, #f0f1f3 25%, #e6e8eb 37%, #f0f1f3 63%);
  background-size: 400% 100%;
  animation: sk 1.2s ease-in-out infinite;
  margin-bottom: 16rpx;
}
.sk-title { width: 55%; height: 30rpx; }
.sk-short { width: 35%; }
.sk-mid { width: 80%; margin-bottom: 0; }
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* --------------------------------------------------------------------------
   树洞入口（组件 treehole-entry 自带紫色渐变，这里只补间距）
   -------------------------------------------------------------------------- */
.hole-entry-wrap { margin-bottom: 24rpx; }

/* 校园盲盒：和树洞并排，海青色区分，两张卡挨着也不会被看成同一件事 */
.bb-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--r-xl);
  background: linear-gradient(135deg, var(--c-bottle-from) 0%, var(--c-bottle-to) 100%);
  box-shadow: 0 8rpx 24rpx var(--c-shadow-brand);
}
.bb-entry__icon {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-xl);
  background: rgba(255, 255, 255, 0.16);
}
.bb-entry__icon-img { width: 52rpx; height: 52rpx; }
.bb-entry__main { flex: 1; min-width: 0; }
.bb-entry__title { font-size: var(--fs-h2); font-weight: 700; color: var(--c-on-strong); }
.bb-entry__sub {
  margin-top: 8rpx;
  font-size: var(--fs-tag);
  color: rgba(255, 255, 255, 0.82);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 入口双卡：树洞 + 盲盒并排。
   两格 flex:1 撑到等高，谁的内容多谁定高；.hole-entry-wrap 只留给搜索态的整宽版。 */
.entry-grid {
  display: flex;
  gap: var(--sp-3);
  margin-bottom: var(--sp-4);
}

.entry-grid__cell { flex: 1; min-width: 0; }

/* 盲盒卡的竖排版：规格和树洞 grid 版一一对应
   （同样的 padding / gap / 88rpx 图标 / fs-sub 标题 / fs-tag 副标题），
   两张卡才不会一头高一头低。 */
.bb-entry--grid {
  flex-direction: column;
  align-items: stretch;
  gap: var(--sp-2);
  margin-bottom: 0;
  padding: var(--sp-5);
}

.bb-entry--grid .bb-entry__icon { width: 64rpx; height: 64rpx; }
.bb-entry--grid .bb-entry__icon-img { width: 36rpx; height: 36rpx; }
.bb-entry--grid .bb-entry__title { font-size: var(--fs-aux); }
.bb-entry--grid .bb-entry__sub { margin-top: 0; font-size: var(--fs-tag); }
.bb-entry--grid .bb-entry__go { display: none; }

.bb-entry__go { flex-shrink: 0; width: 36rpx; height: 36rpx; }

/* 被举报暂停展示：低调的入口，别和内容抢注意力 */
.muted-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--r-xl);
  background: var(--c-market-soft);
  border: 2rpx solid #ffe1a6;
}
.muted-entry__icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: var(--c-card);
}
.muted-entry__icon-img { width: 40rpx; height: 40rpx; }
.muted-entry__main { flex: 1; min-width: 0; }
.muted-entry__title { font-size: var(--fs-sub); font-weight: 600; color: var(--c-amber-deep); }
.muted-entry__sub {
  margin-top: 4rpx;
  font-size: var(--fs-tag);
  color: #b08a3e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.muted-entry__go { flex-shrink: 0; width: 32rpx; height: 32rpx; }

/* --------------------------------------------------------------------------
   悬浮发帖按钮
   -------------------------------------------------------------------------- */
.fab {
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: var(--c-forum);
  box-shadow: 0 12rpx 32rpx rgba(115, 87, 255, 0.34);
}
.fab__icon { width: 48rpx; height: 48rpx; }
