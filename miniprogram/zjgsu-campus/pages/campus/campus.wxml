<page-meta page-style="{{themeStyle}}" />
<view class="container hub">


  <!-- ============ 三档切换：活动信息 / 校历 / 地点地图 ============ -->
  <!-- 选中档用校园绿浅底 #E9F8F1 + 主色文字，切换时底色 / 文字 / 图标一起过渡，
       不做位移，免得 tab 页出现横向跳动 -->
  <view class="hub-seg">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="hub-seg__item {{tabMap[item.key] ? 'on' : ''}} tap pressable"
      data-k="{{item.key}}"
      bindtap="onTab"
    >
      <image
        class="hub-seg__icon"
        src="/assets/icons/{{item.key === 'events' ? 'megaphone' : (item.key === 'calendar' ? 'calendar-days' : 'map-pinned')}}--{{tabMap[item.key] ? 'campus' : 'muted'}}.svg"
        mode="aspectFit"
      />
      <text class="hub-seg__label">{{item.label}}</text>
    </view>
  </view>

  <!-- ============ 活动信息 ============ -->
  <block wx:if="{{tab === 'events'}}">

    <!-- 发布入口：讲座 / 比赛 / 组队都是「有人发起、有人报名」的事 -->
    <view class="card hub-publish tap pressable" bindtap="goAddEvent">
      <view class="hub-publish__icon">
        <image class="hub-publish__icon-img" src="/assets/icons/megaphone--campus.svg" mode="aspectFit" />
      </view>
      <view class="hub-publish__body">
        <view class="hub-publish__title">有活动想发起？</view>

      </view>
      <view class="hub-publish__go">
        <text class="hub-publish__go-text">发布</text>
        <image class="hub-publish__go-icon" src="/assets/icons/chevron-right--campus.svg" mode="aspectFit" />
      </view>
    </view>

    <!-- 我发起的活动。这一行不是为了「看我发过什么」——
         活动被举报下架后公开列表里就查不到了，作者只有从这里才进得去、才恢复得了 -->
    <view class="hub-mine tap pressable" hover-class="hub-mine--hover" hover-stay-time="80" bindtap="goMineEvents">
      <image class="hub-mine__icon" src="/assets/icons/calendar-days--campus.svg" mode="aspectFit" />
      <text class="hub-mine__text">我发起的活动</text>
      <image class="hub-mine__go" src="/assets/icons/chevron-right--campus.svg" mode="aspectFit" />
    </view>

    <!-- 官网同步条：同学最想知道的就是「官方那批有多新」 -->
    <view class="card hub-sync">
      <view class="hub-sync__main">
        <view class="hub-sync__title">
          <image class="hub-sync__icon" src="/assets/icons/graduation-cap--campus.svg" mode="aspectFit" />
          <text class="truncate">学校官网活动 {{officialCount}} 条</text>
        </view>

      </view>
      <view
        class="hub-sync__btn {{syncing ? 'on spin' : 'tap pressable'}}"
        bindtap="onSync"
      >
        <image class="hub-sync__btn-icon" src="/assets/icons/refresh--campus.svg" mode="aspectFit" />
        <text>{{syncing ? '同步中…' : '更新'}}</text>
      </view>
    </view>

    <!-- 没读到 ≠ 没人发。必须放在下面 wx:if / wx:elif / wx:else 链之前，
         插在链条中间会把它拆开 -->
    <net-tip
      show="{{netFail}}"
      block="{{true}}"
      title="活动没拉下来"
      desc="可能是网络抖动，也可能是云端一时没响应。点重试再来一次，本机已缓存的活动不会丢"
      busy="{{netBusy}}"
      bindretry="onRetryNet"
    />

    <!-- 骨架屏：只为「第一次进来、列表还没到」这一秒兜底 -->
    <view wx:if="{{eventLoading}}" class="sk-wrap">
      <view class="sk-card">
        <view class="skeleton sk-line sk-title"></view>
        <view class="skeleton sk-line sk-mid"></view>
      </view>
      <view class="sk-card">
        <view class="skeleton sk-line sk-title"></view>
        <view class="skeleton sk-line sk-short"></view>
      </view>
    </view>

    <view wx:elif="{{events.length === 0 && !netFail}}" class="empty">
      <image class="empty-art" src="/assets/icons/megaphone--muted.svg" mode="aspectFit" />
      <view class="empty-title">还没有人发起活动</view>
      <view class="empty-desc">讲座、竞赛、组队、社团活动都发这里，你可以是第一个</view>
    </view>

    <view wx:elif="{{!netFail}}" class="hub-events">
      <!-- 分类全部平铺展开，不做“筛选”二次收起 -->
      <view class="hub-filt">
        <view class="hub-filt__chip {{evFilter === 'all' ? 'on' : ''}} tap pressable" data-f="all" bindtap="onEvFilter">全部 {{eventCount}}</view>
        <view class="hub-filt__chip {{evFilter === 'official' ? 'on' : ''}} tap pressable" data-f="official" bindtap="onEvFilter">学校官网 {{officialCount}}</view>
        <view class="hub-filt__chip {{evFilter === 'jobfair' ? 'on' : ''}} tap pressable" data-f="jobfair" bindtap="onEvFilter">招聘会 {{jobfairCount}}</view>
        <view class="hub-filt__chip {{evFilter === 'student' ? 'on' : ''}} tap pressable" data-f="student" bindtap="onEvFilter">同学发起 {{studentCount}}</view>
      </view>

      <view wx:if="{{shownOfficial.length}}" class="hub-sec">
        <view class="hub-sec__head">
          <image class="hub-sec__icon" src="/assets/icons/graduation-cap--campus.svg" mode="aspectFit" />
          <text class="truncate">学校官网发布</text>
        </view>

        <!-- 官网活动：主色浅底标签 + 校方来源 + 原文出口。
             用 block wx:for 而不是在卡片上 wx:for：招聘会排在最前面，露完最后一条
             要就地插一行「还有 N 场」（见下），插在列表末尾的话它引出的那批卡片
             明明在开头，看着像在说别的区块的事。 -->
        <block wx:for="{{shownOfficial}}" wx:key="id">
        <view
          class="card ev pressable"
          data-id="{{item.id}}"
          bindtap="goEvent"
        >
          <view class="ev__top">
            <text class="tag ev__tag--official">学校官网</text>
            <!-- 招聘会：标签里带上具体类别 + 举办状态（宣讲会 · 还有 3 天 / 大型招聘会 · 已结束）。
                 类别必须露出来：「宣讲会」是一间教室的小场，「大型招聘会」是一操场的招聘集市，
                 同学安排行程时看的就是这个差别，笼统写个「招聘会」等于没说。
                 类别名直接用就业网自己的栏目分类（宣讲会 / 大型招聘会 / 中型招聘会 /
                 空中招聘会 / 组团招聘会），不去猜标题。
                 单独再挂一个标签会把这行挤爆，所以并成一个。
                 已结束的走灰底 —— 刚办完的还值得看一眼结果，但不该跟即将举办的一样抢眼 -->
            <text
              wx:if="{{item.type === 'jobfair'}}"
              class="tag {{item.jobState === '已结束' ? 'tag--gray' : 'tag--campus'}}"
            >{{item.jobKind}}{{item.jobState ? ' · ' + item.jobState : ''}}</text>
            <text wx:if="{{item.source}}" class="ev__src truncate">{{item.source}}</text>
            <view class="ev__link tap pressable" data-id="{{item.id}}" catchtap="onOfficial">
              <text>原文</text>
              <image class="ev__link-icon" src="/assets/icons/chevron-right--brand.svg" mode="aspectFit" />
            </view>
          </view>

          <view class="ev__title">{{item.title}}</view>
          <view wx:if="{{item.start}}" class="ev__row">
            <image class="ev__row-icon" src="/assets/icons/clock--muted.svg" mode="aspectFit" />
            <text class="truncate">{{item.start}}</text>
          </view>
          <view wx:if="{{item.location}}" class="ev__row">
            <image class="ev__row-icon" src="/assets/icons/map-pin--muted.svg" mode="aspectFit" />
            <text class="truncate">{{item.location}}</text>
          </view>
          <view wx:if="{{item.desc && item.desc.length < 60 && !item.official}}" class="ev__desc clamp2">{{item.desc}}</view>

          <view class="ev__foot">
            <!-- 左边的空位：收藏了就显示「已收藏」，没收藏但有人报名就显示人数，
                 两样都没有就空着，把收藏和「查看详情」推到右边。 -->
            <view class="ev__stat">
              <view wx:if="{{item.favorited}}" class="ev__stat">
                <image class="ev__stat-icon" src="/assets/icons/star--campus.svg" mode="aspectFit" />
                <text>已收藏</text>
              </view>
              <view wx:elif="{{item.joinedCount > 0}}" class="ev__stat">
                <image class="ev__stat-icon" src="/assets/icons/users-round--campus.svg" mode="aspectFit" />
                <text class="truncate">{{item.countText}}</text>
              </view>
            </view>

            <!-- 收藏入口只给招聘会。官网公告是看完就走的东西，不给收藏；
                 为什么收藏比「写进校历设提醒」更合适，见 campus.js 的 onFavEvent 注释。 -->
            <view
              wx:if="{{item.type === 'jobfair'}}"
              class="ev__fav {{item.favorited ? 'ev__fav--on' : ''}} tap pressable"
              data-id="{{item.id}}"
              catchtap="onFavEvent"
            >
              <image
                class="ev__fav-icon"
                src="{{item.favorited ? '/assets/icons/star--campus.svg' : '/assets/icons/star--faint.svg'}}"
                mode="aspectFit"
              />
              <text class="ev__fav-text">{{item.favorited ? '已收藏' : '收藏'}}</text>
            </view>

            <view class="ev__more">
              <text class="ev__more-text">查看详情</text>
              <image class="ev__foot-icon" src="/assets/icons/chevron-right--campus.svg" mode="aspectFit" />
            </view>
          </view>
        </view>


        </block>
      </view>

      <view wx:if="{{shownStudent.length}}" class="hub-sec">
        <view class="hub-sec__head">
          <image class="hub-sec__icon" src="/assets/icons/megaphone--campus.svg" mode="aspectFit" />
          <text class="truncate">同学发起</text>
        </view>

        <!-- 同学活动：校园绿浅底标签，人数 / 报名状态代替「原文」 -->
        <view
          wx:for="{{shownStudent}}"
          wx:key="id"
          class="card ev pressable"
          data-id="{{item.id}}"
          bindtap="goEvent"
        >
          <view class="ev__top">
            <text class="tag tag--campus ev__tag">同学发起</text>
            <text wx:if="{{item.joined}}" class="ev__badge ev__badge--joined">已报名</text>
            <text wx:elif="{{item.isMine}}" class="ev__badge">我发布的</text>
          </view>

          <view class="ev__title">{{item.title}}</view>
          <view wx:if="{{item.start}}" class="ev__row">
            <image class="ev__row-icon" src="/assets/icons/clock--muted.svg" mode="aspectFit" />
            <text class="truncate">{{item.start}}</text>
          </view>
          <view wx:if="{{item.location}}" class="ev__row">
            <image class="ev__row-icon" src="/assets/icons/map-pin--muted.svg" mode="aspectFit" />
            <text class="truncate">{{item.location}}</text>
          </view>
          <view wx:if="{{item.desc}}" class="ev__desc clamp2">{{item.desc}}</view>

          <view class="ev__foot">
            <view class="ev__stat">
              <image class="ev__stat-icon" src="/assets/icons/users-round--campus.svg" mode="aspectFit" />
              <text class="truncate">{{item.countText}}</text>
            </view>
            <view class="ev__more">
              <text class="ev__more-text">查看详情</text>
              <image class="ev__foot-icon" src="/assets/icons/chevron-right--campus.svg" mode="aspectFit" />
            </view>
          </view>
        </view>

        <!-- 上拉加载。只给同学发起这一块：官网那两块各有自己的收口
             （招聘会「还有 N 场」引到专门那档、公告卡 7 天窗口），
             再叠一层分页会让两个机制互相打架。
             studentDone 由分页器给出，活动没多到要分页时这两行都不出现。 -->
        <view wx:if="{{studentHasMore}}" class="load-more">上拉加载更多（还有 {{studentCount - shownStudent.length}} 个）</view>
        <view wx:elif="{{studentDone}}" class="load-more">已经到底啦，共 {{studentCount}} 个同学活动</view>
      </view>
    </view>

    <!-- 悬浮发布入口：tab 页的原生 tabBar 之上，位置固定在右下角 -->
    <view class="fab hub-fab tap pressable" bindtap="goAddEvent">
      <image class="hub-fab__icon" src="/assets/icons/plus--white.svg" mode="aspectFit" />
    </view>
  </block>

  <!-- ============ 校历 ============ -->
  <block wx:elif="{{tab === 'calendar'}}">
    <view class="cal-hero">
      <view class="cal-hero__head">
        <image class="cal-hero__icon" src="/assets/icons/calendar-days--white.svg" mode="aspectFit" />
        <text>最近一个节点</text>
      </view>
      <view class="cal-hero__text">{{calNext}}</view>
    </view>

    <view wx:if="{{calList.length === 0}}" class="empty">
      <image class="empty-art" src="/assets/icons/calendar-days--muted.svg" mode="aspectFit" />
      <view class="empty-title">校历还没取到</view>
      <view class="empty-desc">进来一次就会自动同步</view>
    </view>

    <view wx:else class="cal-list">
      <view
        wx:for="{{calList}}"
        wx:key="id"
        class="cal-item {{item.past ? 'past' : ''}}"
      >
        <view class="cal-item__dot"></view>
        <view class="card cal-item__body">
          <view class="cal-item__main">
            <view class="cal-item__name clamp2">{{item.name}}</view>
            <view class="cal-item__date">{{item.date}}</view>
            <view wx:if="{{item.note}}" class="cal-item__note">{{item.note}}</view>
          </view>
          <view wx:if="{{item.daysText}}" class="cal-item__days">
            <image class="cal-item__days-icon" src="/assets/icons/clock--campus.svg" mode="aspectFit" />
            <text class="truncate">{{item.daysText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="hub-more tap pressable" bindtap="goCalendarFull">
      <image class="hub-more__icon" src="/assets/icons/edit--campus.svg" mode="aspectFit" />
      <text class="hub-more__text">编辑校历 / 导入官方校历</text>
      <image class="hub-more__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>
  </block>

  <!-- ============ 地点地图 ============ -->
  <block wx:elif="{{tab === 'places'}}">
    <!-- 搜索放在分类前面：找地方的人先想到的是「搜一下」，
         不是「它属于哪个分类」。跟完整地点页同一个位置逻辑 -->
    <view class="search-bar hub-search">
      <image class="search-bar__icon" src="/assets/icons/search--faint.svg" mode="aspectFit" />
      <input
        class="search-bar__input"
        placeholder="搜地点：名字 / 楼栋 / 分类（支持模糊）"
        value="{{placeKeyword}}"
        confirm-type="search"
        bindinput="onPlaceKeyword"
        bindconfirm="onPlaceSearchConfirm"
        maxlength="30"
      />
      <view
        wx:if="{{hasPlaceKeyword}}"
        class="search-bar__clear hit pressable"
        bindtap="onPlaceKeywordClear"
      >
        <image class="search-bar__clear-icon" src="/assets/icons/x--muted.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="hub-cats no-scrollbar">
      <scroll-view class="hub-cats__scroll" scroll-x="true" show-scrollbar="{{false}}">
        <view class="chip-row">
          <view
            wx:for="{{placeCats}}"
            wx:for-item="c"
            wx:key="*this"
            class="hub-chip {{hasPlaceKeyword ? 'chip-empty' : ''}} {{placeCatMap[c] ? 'hub-chip--on' : ''}} {{placeCatMap[c] ? '' : 'tap pressable'}}"
            data-c="{{c}}"
            bindtap="onPlaceCat"
          >{{c}}</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{hasPlaceKeyword}}" class="faint hub-search__note">支持少字/错字；搜索时不限分类，点上面任意分类可退出搜索</view>

    <view wx:if="{{placeLoading && placeList.length === 0}}" class="empty">
      <image class="empty-art" src="/assets/icons/map-pin--muted.svg" mode="aspectFit" />
      <view class="empty-title">地点加载中…</view>
    </view>
    <!-- 「搜不到」和「这个分类下没有」是两回事，别用同一句话：
         前者要给人退路（换个说法），后者才该提示去补一个 -->
    <view wx:elif="{{hasPlaceKeyword && placeList.length === 0}}" class="empty">
      <image class="empty-art" src="/assets/icons/search--muted.svg" mode="aspectFit" />
      <view class="empty-title">没找到匹配的地点</view>
      <view class="empty-desc">换个说法试试，比如楼栋的简称</view>
    </view>
    <view wx:elif="{{placeList.length === 0}}" class="empty">
      <image class="empty-art" src="/assets/icons/map-pin--muted.svg" mode="aspectFit" />
      <view class="empty-title">这个分类下还没有地点</view>
    </view>

    <view wx:else class="pl-list">
      <view
        wx:for="{{placeList}}"
        wx:key="id"
        class="card pl pressable {{placeCat === item.category ? 'on' : ''}}"
        data-i="{{index}}"
        bindtap="onPlaceOpen"
      >
        <view class="pl__icon">
          <image
            class="pl__icon-img"
            src="/assets/icons/map-pin--{{placeCat === item.category ? 'campus' : 'muted'}}.svg"
            mode="aspectFit"
          />
        </view>
        <view class="pl__body">
          <view class="pl__name truncate">{{item.name}}</view>
          <view class="pl__meta">
            <text wx:if="{{item.category}}" class="pl__cat">{{item.category}}</text>
            <text wx:if="{{item.desc}}" class="pl__desc truncate">{{item.desc}}</text>
          </view>
        </view>
        <view class="pl__go">
          <text class="pl__go-text">导航</text>
          <image class="pl__go-icon" src="/assets/icons/chevron-right--campus.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- 添加走右下角 ➕，这一行留给「看」和「改」：完整页第一屏是地图，
         能按类别过滤，也能删掉自己加错的地点。 -->
    <view class="hub-more tap pressable" bindtap="goPlacesFull">
      <image class="hub-more__icon" src="/assets/icons/map-pinned--campus.svg" mode="aspectFit" />
      <text class="hub-more__text">完整地图：按类别找地点、删掉自己加错的</text>
      <image class="hub-more__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>

    <!-- 悬浮添加入口：跟活动那一档同一个位置、同一个手势。
         地点是「走到跟前才发现没标」的东西，加它的动作必须比点列表还省事 -->
    <view class="fab hub-fab tap pressable" bindtap="goAddPlace">
      <image class="hub-fab__icon" src="/assets/icons/plus--white.svg" mode="aspectFit" />
    </view>
  </block>


  <view class="refresh-fab tap" style="bottom: calc(260rpx + env(safe-area-inset-bottom));" bindtap="manualRefresh">
    <image class="refresh-fab__icon" src="/assets/icons/refresh--faint.svg" mode="aspectFit" />
    <text>刷新</text>
  </view>

  <view class="backtop-fab tap" style="bottom: calc(150rpx + env(safe-area-inset-bottom));" bindtap="backTop">
    <image class="backtop-fab__icon" src="/assets/icons/arrow-up--faint.svg" mode="aspectFit" />
    <text>顶部</text>
  </view>
</view>