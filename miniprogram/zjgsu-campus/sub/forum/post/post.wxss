/* sub/forum/post/post.wxss —— 发帖器
   折叠面板统一走 .collapse：max-height + opacity + transform 过渡，
   切换发帖模式时看到的是「展开 / 收起」，不是硬跳。 */

.composer { padding-bottom: 64rpx; }

.composer__label {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-text);
}
.composer__hint { font-size: var(--fs-tag); font-weight: 400; color: var(--c-faint); }

/* 上传进度：贴在「配图」标题后面，多图上传时让人知道在动 */
.composer__label-pct {
  font-size: var(--fs-tag);
  font-weight: 600;
  color: #4f6bed;
}

/* --------------------------------------------------------------------------
   板块选择
   -------------------------------------------------------------------------- */
.composer__boards {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.composer__board {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--hit-sm);
  max-width: 100%;
  padding: 0 32rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-sub);
  color: var(--c-muted);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
}
.composer__board.on {
  color: var(--c-on-strong);
  background: var(--c-forum);
  border-color: var(--c-forum);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(115, 87, 255, 0.24);
}
.composer__notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-campus-soft);
  color: var(--c-campus-deep);
  font-size: var(--fs-aux);
  line-height: 1.6;
}
.composer__notice-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-top: 4rpx; }

/* --------------------------------------------------------------------------
   课程关联
   -------------------------------------------------------------------------- */
.composer__picked {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-l);
  background: var(--c-brand-soft);
  color: var(--c-brand-deep);
  font-size: var(--fs-sub);
}
.composer__picked-icon { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.composer__picked-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.composer__picked-clear { flex-shrink: 0; font-size: var(--fs-aux); color: var(--c-muted); }

.composer__field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-l);
  background: var(--c-bg);
  font-size: var(--fs-body);
  color: var(--c-text);
  box-sizing: border-box;
}
.composer__title-field { margin-bottom: 8rpx; }

.composer__pick {
  margin-top: 16rpx;
  border-radius: var(--r-l);
  background: var(--c-sunken);
  max-height: 520rpx;
  overflow: hidden;
}
.composer__pick-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 16rpx 24rpx;
}
.composer__pick-item + .composer__pick-item { border-top: 2rpx solid var(--c-line); }
.composer__pick-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--c-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.composer__pick-college { flex-shrink: 0; font-size: var(--fs-tag); }
.composer__pick-none { margin-top: 16rpx; font-size: var(--fs-aux); line-height: 1.6; }

/* --------------------------------------------------------------------------
   配图
   -------------------------------------------------------------------------- */
.composer__imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.composer__img-cell {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-l);
  overflow: hidden;
  background: var(--c-fill);
}
.composer__img { width: 160rpx; height: 160rpx; display: block; }
.composer__img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(23, 32, 51, 0.5);
}
.composer__img-del-icon { width: 28rpx; height: 28rpx; }
.composer__add {
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  background: var(--c-bg);
  border: 2rpx dashed #d4dcea;
  box-sizing: border-box;
}
.composer__add-icon { width: 44rpx; height: 44rpx; }
.composer__add-text { font-size: var(--fs-tag); color: var(--c-faint); }

/* --------------------------------------------------------------------------
   帖子形式三选一
   -------------------------------------------------------------------------- */
.composer__kinds {
  display: flex;
  gap: 16rpx;
}
.composer__kind {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 140rpx;
  padding: 16rpx 8rpx;
  border-radius: var(--r-l);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
  transition: background-color 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
}
.composer__kind.on {
  border-color: var(--c-forum);
  background: var(--c-forum-soft);
  box-shadow: 0 6rpx 18rpx rgba(115, 87, 255, 0.14);
}
.composer__kind-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.composer__kind-name { font-size: var(--fs-sub); font-weight: 600; color: var(--c-text); }
.composer__kind.on .composer__kind-name { color: var(--c-forum); }
.composer__kind-sub { font-size: var(--fs-micro); }

/* --------------------------------------------------------------------------
   折叠面板：max-height + opacity + transform
   -------------------------------------------------------------------------- */
/* 折叠面板：只动 max-height + opacity，刻意不用 transform。
 *
 * ⚠️ 这里曾经有一条 transform: translateY(-12rpx) —— 在 iOS 上它正是
 *    「左右滑动出现额外文字」的成因之一：面板里有 <textarea>，
 *    而 textarea 是原生组件，画在独立图层上，**不受父级 overflow:hidden 裁剪**。
 *    父容器一旦带 transform（合成的图层），横向滑动触发重绘时，
 *    textarea 就会把自己的内容画到容器外面，页面上凭空多出一段文字。
 *    去掉 transform 之后这个图层退化成普通图层，不再出现错位渲染。
 *
 * visibility 是第二道保险：即便某一版 WebView 的 overflow:hidden 裁剪失效，
 * 收起状态的内容也不会显示出来（顺带也没了被读屏软件读到的可能）。 */
.collapse {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  visibility: hidden;
  transition: max-height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
              opacity 0.22s ease,
              visibility 0s linear 0.34s;
}
.collapse--open {
  max-height: 1600rpx;
  opacity: 1;
  visibility: visible;
  margin-top: 24rpx;
  transition: max-height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
              opacity 0.22s ease,
              visibility 0s linear 0s;
}
.collapse__inner { padding-top: 4rpx; }

/* 正文面板：展开后和标题之间补一条分隔，收起时不会留一条空边 */
.collapse--open > .collapse__inner { border-top: 2rpx solid var(--c-line); padding-top: 24rpx; }
.collapse--topic.collapse--open > .collapse__inner { border-top: none; padding-top: 0; }

.composer__textarea {
  width: 100%;
  min-height: 260rpx;
  max-height: 620rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-bg);
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--c-text);
  box-sizing: border-box;
}
.composer__counter { margin-top: 12rpx; text-align: right; font-size: var(--fs-tag); color: var(--c-faint); }

.composer__topic-box {
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-forum-soft);
  color: var(--c-forum);
  font-size: var(--fs-aux);
  line-height: 1.75;
}
.composer__topic-line {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.composer__topic-line > text { flex: 1; min-width: 0; }
.composer__topic-icon { width: 26rpx; height: 26rpx; flex-shrink: 0; margin-top: 8rpx; }
.composer__topic-tip {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-market-soft);
  color: var(--c-market-deep);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   投票设置面板
   -------------------------------------------------------------------------- */
.vote-panel { margin-bottom: 0; background: #fbfcff; }

.vote-panel__head { display: flex; align-items: center; gap: 20rpx; }
.vote-panel__badge {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-l);
  background: var(--c-brand);
}
.vote-panel__badge-icon { width: 44rpx; height: 44rpx; }
.vote-panel__title { font-size: var(--fs-h2); font-weight: 700; color: var(--c-text); }
.vote-panel__sub { margin-top: 4rpx; font-size: var(--fs-tag); }

.vote-panel__block { margin-top: 28rpx; }
.vote-panel__block-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }

.vote-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 96rpx;
  padding: 0 12rpx;
  margin-bottom: 16rpx;
  border-radius: var(--r-l);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
}
.vote-row__grip {
  flex-shrink: 0;
  width: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vote-row__grip-icon { width: 32rpx; height: 32rpx; }
.vote-row__input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: var(--fs-body);
  color: var(--c-text);
}
.vote-row__btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
}
.vote-row__btn--off { opacity: 0.28; }
.vote-row__btn-icon { width: 34rpx; height: 34rpx; }

.vote-panel__add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  border-radius: var(--r-l);
  border: 2rpx dashed #d4dcea;
  background: var(--c-card);
  color: var(--c-brand-deep);
  font-size: var(--fs-sub);
}
.vote-panel__add--off { opacity: 0.45; }
.vote-panel__add-icon { width: 32rpx; height: 32rpx; }

.vote-panel__seg {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: var(--r-pill);
  background: var(--c-fill);
}
.vote-panel__seg-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-sub);
  color: var(--c-muted);
  transition: background-color 0.24s ease, color 0.24s ease;
}
.vote-panel__seg-item.on {
  background: var(--c-card);
  color: var(--c-brand-deep);
  font-weight: 600;
  box-shadow: var(--sh-4);
}
.vote-panel__seg-hint { font-size: var(--fs-micro); }

.vote-panel__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.vote-panel__chips .pill { min-height: var(--hit-sm); padding: 0 32rpx; font-size: var(--fs-sub); }
.pill-on {
  background: var(--c-brand);
  color: var(--c-on-strong);
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(43, 90, 237, 0.2);
}

.vote-panel__row { display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; }
.vote-panel__row-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.vote-panel__row-text { flex: 1; min-width: 0; }
.vote-panel__row-title { font-size: var(--fs-body); font-weight: 600; color: var(--c-text); }
.vote-panel__row-sub { margin-top: 4rpx; font-size: var(--fs-tag); line-height: 1.5; }

.vote-panel__foot {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-l);
  font-size: var(--fs-aux);
  text-align: center;
}
.vote-panel__foot--ok { background: var(--c-campus-soft); color: var(--c-campus-deep); }
.vote-panel__foot--warn { background: var(--c-market-soft); color: var(--c-market-deep); }

/* --------------------------------------------------------------------------
   开关（匿名发布 / 匿名投票共用）
   -------------------------------------------------------------------------- */
.switch {
  flex-shrink: 0;
  width: 88rpx;
  height: 52rpx;
  padding: 4rpx;
  border-radius: var(--r-pill);
  background: #dfe5ef;
  display: flex;
  align-items: center;
  transition: background-color 0.24s ease;
}
.switch--on { background: var(--c-brand); }
.switch__dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-pill);
  background: var(--c-card);
  box-shadow: 0 2rpx 6rpx rgba(23, 32, 51, 0.18);
  transform: translateX(0);
  transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
}
.switch--on .switch__dot { transform: translateX(36rpx); }

/* --------------------------------------------------------------------------
   匿名发布卡
   -------------------------------------------------------------------------- */
.anon-card__row { display: flex; align-items: center; gap: 20rpx; }
.anon-card__icon {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-xl);
  background: var(--c-sunken);
}
.anon-card__icon-img { width: 44rpx; height: 44rpx; }
.anon-card__main { flex: 1; min-width: 0; }
.anon-card__title { font-size: var(--fs-h2); font-weight: 600; color: var(--c-text); }
.anon-card__sub { margin-top: 8rpx; font-size: var(--fs-tag); line-height: 1.5; }
.anon-card__tip {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--r-l);
  background: var(--c-forum-soft);
  color: var(--c-forum);
  font-size: var(--fs-aux);
  line-height: 1.6;
}
/* 匿名不等于匿名：放在匿名卡片里，发布前必读到 */
.anon-card__legal {
  margin-top: 16rpx;
  font-size: var(--fs-aux);
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   底部按钮
   -------------------------------------------------------------------------- */
.composer__actions {
  display: flex;
  gap: 24rpx;
  padding-top: 8rpx;
}
.composer__draft,
.composer__submit {
  flex: 1;
  min-height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: var(--fs-h2);
  font-weight: 600;
  border: none;
  box-sizing: border-box;
}
.composer__draft {
  flex: 0 0 260rpx;
  background: var(--c-brand-soft);
  color: var(--c-brand-deep);
}
.composer__submit {
  background: var(--c-brand);
  color: var(--c-on-strong);
  box-shadow: var(--sh-3);
}
.composer__submit--off { background: var(--c-disabled); color: var(--c-on-strong); box-shadow: none; }
.composer__draft::after,
.composer__submit::after { border: none; }
/* 按下瞬间的反馈：小程序里 view 的 :active 伪类并不可靠，button/view 必须靠
   hover-class 才能在手指落下那一帧变色。没有它，用户点下去连「按到了没」都不知道，
   再加上 iOS 收键盘那一帧偶尔吞掉第一次点击，体验就是「点了没反应」 */
.composer__draft--press { background: #dbe6ff; opacity: 0.85; }
.composer__submit--press { background: #1f47c4; opacity: 0.9; box-shadow: none; }
