/* sub/market/mine/mine.wxss —— 我发布的
   场景色：闲置橙 #F58A32 / 浅底 #FFF3E9 / 标签文字 #D9731F */

.w-page { padding-top: 20rpx; }

/* ---------- 骨架屏 ---------- */
.sk-wrap { margin-bottom: 24rpx; }
.sk-card {
  background: var(--c-card);
  border-radius: var(--r-xl);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-line { margin-bottom: 16rpx; }
.sk-title { width: 55%; height: 30rpx; }
.sk-mid { width: 80%; margin-bottom: 0; }

/* ---------- 空状态：牛皮纸袋 ---------- */
.empty-bag { padding: 12rpx 0 32rpx; }
.empty-bag__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 48rpx;
  border-radius: var(--r-xl);
  background: var(--c-card);
  box-shadow: var(--sh-1);
}
.empty-bag__img { width: 400rpx; height: 340rpx; }
.empty-bag__title { margin-top: 8rpx; font-size: var(--fs-h2); font-weight: 600; color: var(--c-text); }
.empty-bag__desc {
  margin-top: 12rpx;
  max-width: 440rpx;
  font-size: var(--fs-aux);
  color: var(--c-muted);
  line-height: 1.7;
}
.empty-bag__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 48rpx;
  border-radius: var(--r-pill);
  background: var(--c-market);
  color: var(--c-on-strong);
  font-size: var(--fs-body);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(245, 138, 50, 0.22);
}
.empty-bag__cta--hover { opacity: 0.72; }
.empty-bag__cta-icon { width: 32rpx; height: 32rpx; }

/* ---------- 列表卡片 ---------- */
.w-item { padding: 28rpx; }
.w-item--hover { opacity: 0.72; }

.w-item__top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.w-item__kind-icon { width: 24rpx; height: 24rpx; margin-right: 8rpx; }
.w-item__state {
  margin-left: auto;
  flex-shrink: 0;
  font-size: var(--fs-tag);
  color: var(--c-muted);
  background: var(--c-fill);
  padding: 8rpx 16rpx;
  border-radius: var(--r-pill);
}

/* 暂停展示不是「已解决」那种中性状态，得让人一眼看见 */
.w-item__state--warn {
  color: var(--c-amber);
  background: var(--c-amber-soft);
}

.w-item__title { font-size: var(--fs-h2); font-weight: 600; line-height: 1.45; color: var(--c-text); }
.w-item__desc { margin-top: 12rpx; font-size: var(--fs-sub); color: var(--c-muted); line-height: 1.6; }

.w-item__imgs { display: flex; gap: 12rpx; margin-top: 20rpx; }
.w-item__img {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: var(--r-m);
  background: #f4f5f7;
}

.w-item__foot { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.w-item__price { flex-shrink: 0; font-size: var(--fs-h2); font-weight: 700; color: var(--c-market); }
.w-item__time { margin-left: auto; flex-shrink: 0; }

.w-gap { height: 24rpx; }

/* ---------- 底部常驻发布条 ---------- */
.w-publish {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 96rpx;
  margin-top: 12rpx;
  border-radius: var(--r-pill);
  background: var(--c-market-soft);
  color: var(--c-market-deep);
  font-size: var(--fs-body);
  font-weight: 600;
}
.w-publish__icon { width: 36rpx; height: 36rpx; }
.w-publish--hover { opacity: 0.72; }
