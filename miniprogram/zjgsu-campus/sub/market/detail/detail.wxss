/* sub/market/detail/detail.wxss —— 信息详情
   场景色：闲置橙 #F58A32 / 浅底 #FFF3E9 / 标签文字 #D9731F */

.d-page { padding-top: 20rpx; }

.d-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 120rpx 0;
}
.d-loading__icon { width: 64rpx; height: 64rpx; }

/* 记录不见了：别只丢一行灰字，给一个明确说法 */
.d-missing {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}
.d-missing__icon { width: 112rpx; height: 112rpx; }
.d-missing__title { margin-top: 24rpx; font-size: var(--fs-h2); font-weight: 600; color: var(--c-text); }
.d-missing__desc { margin-top: 12rpx; font-size: var(--fs-aux); color: var(--c-muted); line-height: 1.7; }

/* 被举报暂停展示：只有作者看得到。
   用琥珀色而不是红色 —— 这是「先别展示、等你确认」，不是判定违规 */
.d-paused {
  margin-bottom: 24rpx;
  padding: var(--sp-4);
  border-radius: var(--r-l);
  background: var(--c-amber-soft);
}
.d-paused__title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-text);
}
.d-paused__desc {
  margin-top: var(--sp-2);
  font-size: var(--fs-aux);
  line-height: 1.7;
  color: var(--c-muted);
}
.d-paused__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--hit);
  margin-top: var(--sp-3);
  padding: 0 var(--sp-5);
  border-radius: var(--r-pill);
  background: var(--c-brand);
  color: var(--c-on-strong);
  font-size: var(--fs-aux);
  font-weight: 600;
}
.d-paused__btn--hover { opacity: 0.9; }

/* ---------- 图片 ---------- */
.d-imgs { display: flex; gap: 12rpx; margin-bottom: 24rpx; flex-wrap: wrap; }
.d-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: var(--r-l);
  background: #f4f5f7;
}

/* ---------- 标题卡 ---------- */
.d-kind__icon { width: 24rpx; height: 24rpx; margin-right: 8rpx; }
.d-title { margin-top: 16rpx; font-size: var(--fs-title); font-weight: 700; line-height: 1.4; color: var(--c-text); }
.d-desc {
  margin-top: 20rpx;
  font-size: var(--fs-body);
  color: var(--c-muted);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 浏览人数：跟标题描述同一块，读起来是「这条内容的一句话附注」，不单独占一张卡 */
.d-views {
  margin-top: var(--sp-3);
  font-size: var(--fs-tag);
  color: var(--c-faint);
}

/* ---------- 信息行 ---------- */
.d-row { display: flex; align-items: center; gap: 16rpx; min-height: 96rpx; }
.d-row + .d-row { border-top: 2rpx solid var(--c-line); }
.d-row__icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.d-row__k { flex-shrink: 0; width: 120rpx; font-size: var(--fs-sub); color: var(--c-faint); }
.d-row__v { flex: 1; min-width: 0; font-size: var(--fs-sub); color: var(--c-text); word-break: break-all; }
.d-price { flex-shrink: 0; font-size: var(--fs-h2); font-weight: 700; color: var(--c-market); }

/* ---------- 联系方式（整块橙色浅底，这页的主角） ---------- */
.d-contact {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-xl);
  background: var(--c-market-soft);
  box-shadow: 0 8rpx 24rpx rgba(245, 138, 50, 0.12);
}
.d-contact__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.d-contact__body { flex: 1; min-width: 0; }
.d-contact__label { font-size: var(--fs-tag); color: var(--c-market-deep); }
.d-contact__value {
  margin-top: 4rpx;
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--c-market-deep);
  word-break: break-all;
}
.d-copy {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--r-pill);
  background: var(--c-market);
  color: var(--c-on-strong);
  font-size: var(--fs-sub);
  font-weight: 600;
}
.d-copy--hover { opacity: 0.72; }

/* ---------- 操作 ---------- */
.d-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: var(--r-pill);
  background: var(--c-brand-soft);
  color: var(--c-brand-deep);
  font-size: var(--fs-body);
  font-weight: 600;
  box-sizing: border-box;
}
.d-share::after { border: none; }
.d-share image { width: 36rpx; height: 36rpx; }

.d-mine { display: flex; gap: 20rpx; margin-top: 28rpx; }
.d-op {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 96rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-campus-soft);
  color: var(--c-campus-deep);
  font-size: var(--fs-sub);
  font-weight: 600;
}
.d-op image { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.d-op--hover { opacity: 0.72; }
.d-op--danger { background: var(--c-danger-soft); color: var(--c-danger); }

.d-else { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.d-else__tip {
  text-align: center;
  font-size: var(--fs-aux);
  color: var(--c-faint);
  line-height: 1.7;
}
/* 举报入口刻意做得轻：它是兜底手段，不该和「打个招呼」抢注意力 */
.d-report {
  margin-top: var(--sp-4);
  padding: var(--sp-2) 0;
  text-align: center;
  font-size: var(--fs-aux);
  color: var(--c-faint);
  text-decoration: underline;
}
.d-chat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: var(--r-pill);
  background: var(--c-market);
  color: var(--c-on-strong);
  font-size: var(--fs-h2);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(245, 138, 50, 0.24);
  box-sizing: border-box;
}
.d-chat::after { border: none; }
.d-chat--hover { opacity: 0.72; }
.d-chat image { width: 36rpx; height: 36rpx; }
