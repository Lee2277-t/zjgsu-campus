/* pages/search —— 跨模块统一搜索。类名统一 sc-*，
   .card / .container / .truncate / .pressable 来自 app.wxss。 */

.sc { padding-bottom: 60rpx; }

/* ---------------- 顶部输入框 ---------------- */
.sc-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
}
.sc-bar__icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.sc-bar__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: var(--fs-body);
  color: var(--c-text);
}
.sc-bar__ph { color: var(--c-faint); }
.sc-bar__clear {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sc-bar__clear-img { width: 32rpx; height: 32rpx; }

/* ---------------- 分组标题 ---------------- */
.sc-sec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 8rpx;
}
.sc-sec__act {
  font-size: var(--fs-aux);
  font-weight: 400;
  color: var(--c-brand);
}

/* ---------------- 命中项 ---------------- */
.sc-group { margin-bottom: 24rpx; }
.sc-hit {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--c-line);
}
.sc-hit:first-of-type { border-top: none; }
.sc-hit--hover { opacity: 0.72; }
.sc-hit__main { flex: 1; min-width: 0; }
.sc-hit__title { font-size: var(--fs-body); color: var(--c-text); }
.sc-hit__sub { margin-top: 8rpx; font-size: var(--fs-tag); color: var(--c-faint); }
.sc-hit__go { width: 30rpx; height: 30rpx; flex-shrink: 0; margin-left: 12rpx; }

/* ---------------- 历史 / 热词 ---------------- */
.sc-tags { display: flex; flex-wrap: wrap; padding-top: 12rpx; }
.sc-tag {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--c-sunken);
  color: var(--c-muted);
  font-size: var(--fs-aux);
}
.sc-tag--hot { background: var(--c-brand-soft); color: var(--c-brand); }

/* ---------------- 空结果 ---------------- */
.sc-empty {
  padding: 80rpx 40rpx;
  text-align: center;
}
.sc-empty__title {
  font-size: var(--fs-h2);
  color: var(--c-text);
  font-weight: 600;
}
.sc-empty__sub {
  margin-top: 16rpx;
  font-size: var(--fs-aux);
  color: var(--c-faint);
  line-height: 1.8;
}
