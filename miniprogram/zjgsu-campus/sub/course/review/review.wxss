/* pages/course/review —— 写 / 改评价。类名一律 rv-*，
   app.wxss 里的 .card / .tag / .title-sm / .muted 直接复用。
   底部留出 200rpx 给最后一组按钮，别让「提交」贴着屏幕底边。 */
.rv-page {
  padding-bottom: 200rpx;
}

.rv-label {
  font-size: var(--fs-body);
  font-weight: 600;
  margin-bottom: 20rpx;
}
/* 老师模式页头：这条评价不挂课程，说明一句，免得发完找不到它去哪了 */
.rv-only { border: 2rpx dashed #c9d6f5; }
.rv-only-sub { margin-top: 12rpx; font-size: var(--fs-aux); }

.rv-course {
  margin-top: 8rpx;
}

/* ---------- 评分对象 + 星条 ---------- */
.rv-targets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.rv-target {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--r-pill);
  background: #f4f6f9;
  border: 2rpx solid #e6e9ee;
  font-size: var(--fs-sub);
  color: var(--c-muted);
}
.rv-target-on {
  background: var(--c-brand);
  border-color: var(--c-brand);
  color: var(--c-on-strong);
  font-weight: 600;
}
.rv-target-num {
  margin-left: 8rpx;
  font-size: var(--fs-tag);
  color: var(--c-faint);
}
.rv-target-on .rv-target-num { color: #ffe0b2; }
.rv-target-off {
  border-style: dashed;
  color: var(--c-faint);
}

.rv-scale-title {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 12rpx;
}

.rv-stars {
  display: flex;
  align-items: center;
}
/* 星：热区 88rpx，图标 60rpx，够点也够看 */
.rv-star {
  width: 96rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rv-star-icon {
  width: 56rpx;
  height: 56rpx;
}
.rv-star-text {
  margin-left: 16rpx;
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--c-amber);
}
/* 老师分用偏暖的橙色，和课程分的蓝调区分开，一眼看得出在打哪个分 */
.rv-star-text--warm { color: var(--c-market); }
.rv-star-hint {
  margin-top: 12rpx;
  font-size: var(--fs-aux);
  line-height: 1.6;
}

.rv-tip {
  margin-top: 12rpx;
  font-size: var(--fs-aux);
  line-height: 1.6;
  color: var(--c-muted);
}
.rv-tip-ok {
  display: flex;
  align-items: center;
  color: var(--c-campus-deep);
}
.rv-tip-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* ---------- 匿名 ---------- */
.rv-anon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.rv-anon-main {
  min-width: 0;
}
.rv-anon-sub {
  margin-top: 4rpx;
  font-size: var(--fs-aux);
}

/* ---------- 标签多选 ---------- */
.rv-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
/* 没选中的标签盖掉 .tag 的场景色，保持「可多选但还没选」的观感 */
.rv-tag-off {
  background: #f0f1f3;
  color: var(--c-muted);
}
.rv-picked {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.rv-picked-label { font-size: var(--fs-aux); }
.rv-picked-tag { background: var(--c-brand-soft); color: var(--c-brand-deep); }

/* ---------- 任课老师 ---------- */
.rv-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: var(--fs-body);
  color: var(--c-text);
  background: var(--c-sunken);
  border-radius: var(--r-l);
  box-sizing: border-box;
}
.rv-match {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.rv-match-chip {
  font-size: var(--fs-aux);
  color: var(--c-muted);
  background: #f2f4f7;
  border-radius: var(--r-pill);
  padding: 12rpx 24rpx;
}
.rv-match-chip-on {
  background: var(--c-brand);
  color: var(--c-on-strong);
  font-weight: 600;
}
.rv-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  margin-top: 16rpx;
  border-radius: var(--r-l);
  background: var(--c-brand-soft);
  color: var(--c-brand-deep);
  font-size: var(--fs-sub);
  font-weight: 600;
}
.rv-add-icon {
  width: 30rpx;
  height: 30rpx;
}
.rv-to-teacher {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #e3e7ec;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--c-brand);
}

/* ---------- 正文 ---------- */
.rv-textarea {
  width: 100%;
  height: 260rpx;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--c-text);
  box-sizing: border-box;
  background: var(--c-sunken);
  border-radius: var(--r-l);
  padding: 20rpx 24rpx;
}
.rv-counter {
  margin-top: 8rpx;
  text-align: right;
  font-size: var(--fs-tag);
  color: var(--c-faint);
}

/* ---------- 底部按钮组 ---------- */
.rv-submit {
  display: block;
  margin-top: 12rpx;
}
.rv-submit base-button { margin-bottom: 20rpx; }
