/* sub/campus/add/add —— 发起校园活动表单
   表单控件统一走「浅灰底 + 校园绿聚焦描边」，与 app.wxss 的令牌保持一致。 */

.add-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-aux);
  color: var(--c-muted);
  margin: 28rpx 0 12rpx;
}
.add-label:first-child { margin-top: 0; }
.add-req { color: var(--c-danger); }

.add-types {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.add-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid var(--c-line);
  background: var(--c-card);
  color: var(--c-muted);
  font-size: var(--fs-sub);
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}
.add-type.on {
  background: var(--c-campus-soft);
  border-color: var(--c-campus);
  color: var(--c-campus-deep);
  font-weight: 600;
}
.add-type__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.add-type__label { max-width: 120rpx; overflow: hidden; white-space: nowrap; }
.add-type__check {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-left: 2rpx;
}

.add-input,
.add-textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--c-sunken);
  border-radius: var(--r-l);
  font-size: var(--fs-body);
  color: var(--c-text);
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}
.add-input {
  min-height: var(--hit);
  padding: 20rpx 24rpx;
}
.add-textarea {
  min-height: 200rpx;
  max-height: 560rpx;
  padding: 20rpx 24rpx;
  line-height: 1.7;
}
.add-ph { color: var(--c-faint); }

.add-time {
  display: flex;
  gap: 16rpx;
}
.add-time__cell {
  flex: 1;
  min-width: 0;
}
.add-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: var(--hit);
  padding: 0 24rpx;
  border-radius: var(--r-l);
  background: var(--c-sunken);
  font-size: var(--fs-body);
  color: var(--c-text);
}
.add-picker__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.add-picker.ph { color: var(--c-faint); }

.add-count {
  text-align: right;
  font-size: var(--fs-tag);
  color: var(--c-faint);
  margin-top: 12rpx;
}

.add-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  margin: 8rpx 0 0;
  border-radius: var(--r-pill);
  font-size: var(--fs-h2);
  font-weight: 600;
  line-height: 1.3;
}
.add-submit::after { border: none; }
.add-submit--hover { opacity: 0.86; }

.add-tip {
  font-size: var(--fs-tag);
  color: var(--c-faint);
  text-align: center;
  line-height: 1.7;
  padding: 20rpx 24rpx 60rpx;
}
