/* components/ui/avatar-editor/index.wxss */
.ui-avatar {
  position: relative;
  border-radius: var(--r-pill);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--c-fill);
  box-shadow: var(--sh-1);
}

.ui-avatar__img {
  width: 100%;
  height: 100%;
}

.ui-avatar__ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-hero);
  font-weight: 700;
  color: var(--c-on-strong);
  background: linear-gradient(135deg, var(--c-profile), var(--c-brand));
}

.ui-avatar__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(23, 32, 51, 0.55), rgba(23, 32, 51, 0));
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 12rpx;
}

.ui-avatar__mask-icon { width: 36rpx; height: 36rpx; }

.ui-avatar__loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(23, 32, 51, 0.45);
  animation: avatarPulse 1.2s ease-in-out infinite;
}

@keyframes avatarPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
