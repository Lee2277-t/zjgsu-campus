/* components/ui/empty-state/index.wxss */
.ui-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  text-align: center;
}

.ui-empty__icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-xl);
  background: var(--c-fill);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.ui-empty__icon { width: 56rpx; height: 56rpx; }

.ui-empty__title {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--c-text);
}

.ui-empty__desc {
  margin-top: 12rpx;
  font-size: var(--fs-aux);
  color: var(--c-muted);
  line-height: 1.7;
}

.ui-empty__btn {
  margin-top: 32rpx;
  min-height: 88rpx;
  padding: 0 48rpx;
  line-height: 88rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand-soft);
  color: var(--c-brand-deep);
  font-size: var(--fs-body);
  font-weight: 600;
  border: none;
}
.ui-empty__btn::after { border: none; }
.ui-empty__btn--hover { opacity: 0.72; }
