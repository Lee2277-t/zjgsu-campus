/* components/ui/privacy-modal/index.wxss
   样式硬约束（见 app.wxss 文件头）：不用 backdrop-filter / clamp；
   遮罩用半透明实色，不做毛玻璃 —— 小程序 WebView 不保证支持。 */

.pm-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 0 48rpx;
}

.pm-card {
  width: 100%;
  background: var(--c-card);
  border-radius: var(--r-l);
  padding: 44rpx var(--sp-9) 32rpx;
  box-sizing: border-box;
}

.pm-title {
  font-size: var(--fs-title);
  font-weight: 500;
  color: var(--c-text);
  text-align: center;
  margin-bottom: 24rpx;
}

.pm-body {
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--c-text);
}

.pm-link {
  color: var(--c-brand);
}

.pm-note {
  margin-top: 20rpx;
  font-size: var(--fs-aux);
  line-height: 1.7;
  color: var(--c-muted);
  background: #f5f7fb;
  border-radius: var(--r-m);
  padding: 20rpx 24rpx;
}

.pm-btn {
  margin-top: var(--sp-9);
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-xl);
  font-size: var(--fs-h2);
}

.pm-btn--agree {
  background: var(--c-brand);
  color: var(--c-on-strong);
}

.pm-deny {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--fs-sub);
  color: var(--c-faint);
  padding: 12rpx 0;
}
