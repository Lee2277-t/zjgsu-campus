/* components/ui/treehole-entry/index.wxss */
.ui-hole {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: var(--r-xl);
  overflow: hidden;
  background: linear-gradient(135deg, var(--c-hole-from) 0%, var(--c-hole-from) 55%, var(--c-hole-to) 100%);
  box-shadow: 0 8rpx 24rpx var(--c-shadow-brand);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.ui-hole--hover { opacity: 0.85; transform: scale(0.99); }

/* 星点颗粒 */
.ui-hole__star {
  position: absolute;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.75);
}
.ui-hole__star--1 { width: 8rpx; height: 8rpx; top: 32rpx; left: 48rpx; }
.ui-hole__star--2 { width: 6rpx; height: 6rpx; top: 96rpx; left: 128rpx; opacity: 0.6; }
.ui-hole__star--3 { width: 8rpx; height: 8rpx; top: 48rpx; right: 96rpx; opacity: 0.55; }
.ui-hole__star--4 { width: 6rpx; height: 6rpx; top: 132rpx; right: 44rpx; opacity: 0.45; }

.ui-hole__inner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: var(--sp-9) 32rpx;
}

.ui-hole__art {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
}

.ui-hole__text { flex: 1; min-width: 0; }

.ui-hole__title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--c-on-strong);
  line-height: 1.3;
}

.ui-hole__sub {
  margin-top: 8rpx;
  font-size: var(--fs-aux);
  color: rgba(255, 255, 255, 0.82);
}

.ui-hole__privacy {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.16);
  font-size: var(--fs-tag);
  color: rgba(255, 255, 255, 0.92);
  width: fit-content;
}

.ui-hole__shield { width: 24rpx; height: 24rpx; }

.ui-hole__go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.18);
  color: var(--c-on-strong);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.ui-hole__go-icon { width: 28rpx; height: 28rpx; }

/* --------------------------------------------------------------------------
   半宽竖排版：给论坛首屏的「树洞 + 盲盒」一行双卡用
   布局从「插画 | 文案 | 按钮」改成「插画 / 标题 / 副标题」竖排，
   因为 343rpx 的半宽卡横排最多只放得下四个字。
   高度 ≒ padding 28×2 + 插画 88 + gap 16 + 标题 34 + 副标题 34 ≈ 228rpx，
   和右邻的盲盒卡天然等高（父级 flex 的 align-items 默认 stretch）。
   -------------------------------------------------------------------------- */
.ui-hole--grid { margin-bottom: 0; }

.ui-hole--grid .ui-hole__inner {
  flex-direction: column;
  align-items: stretch;
  gap: var(--sp-2);
  padding: var(--sp-5);
}

.ui-hole--grid .ui-hole__art {
  align-self: flex-start;
  width: 64rpx;
  height: 64rpx;
}

.ui-hole--grid .ui-hole__text { width: 100%; }

.ui-hole--grid .ui-hole__title { font-size: var(--fs-sub); }

.ui-hole--grid .ui-hole__sub {
  margin-top: var(--sp-2);
  font-size: var(--fs-tag);
}
