/* components/ui/vote-card/index.wxss
   进度条动画必须 500ms：Web 版是 transition-all duration-500 ease-out */
.ui-vote {
  background: var(--c-card);
  border-radius: var(--r-xl);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-1);
  padding: 28rpx;
}

.ui-vote__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ui-vote__badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand);
}
.ui-vote__badge-icon { width: 26rpx; height: 26rpx; }
.ui-vote__badge-text { font-size: var(--fs-tag); font-weight: 600; color: var(--c-on-strong); }

.ui-vote__status {
  font-size: var(--fs-tag);
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-campus-soft);
  color: var(--c-campus-deep);
}
.ui-vote__status--end { background: var(--c-fill); color: var(--c-faint); }

.ui-vote__multi {
  font-size: var(--fs-tag);
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-forum-soft);
  color: var(--c-forum);
}

.ui-vote__body { padding: 0; }

.ui-vote__title {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--c-text);
  line-height: 1.5;
  min-height: 88rpx;
  display: flex;
  align-items: flex-start;
}

.ui-vote__option { margin-top: 24rpx; }

.ui-vote__option-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.ui-vote__option-label {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--fs-sub);
  color: var(--c-text);
}
.ui-vote__option-label--on { color: var(--c-brand-deep); font-weight: 600; }

.ui-vote__option-text { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.ui-vote__check {
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ui-vote__check-icon { width: 20rpx; height: 20rpx; }

.ui-vote__pct {
  flex-shrink: 0;
  font-size: var(--fs-aux);
  color: var(--c-muted);
  font-variant-numeric: tabular-nums;
}

.ui-vote__track {
  height: 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-fill);
  overflow: hidden;
}

.ui-vote__fill {
  height: 100%;
  border-radius: var(--r-pill);
  /* 关键：500ms 过渡，与 Web 版 transition-all duration-500 对齐 */
  transition: width 0.5s ease-out, background-color 0.5s ease-out;
}
.ui-vote__fill--top { background: linear-gradient(90deg, var(--c-brand), var(--c-forum)); }
.ui-vote__fill--on { background: #5d8cff; }
.ui-vote__fill--idle { background: #c9d3e2; }

.ui-vote__option--locked .ui-vote__option-label { cursor: default; }
.ui-vote__option--hover { opacity: 0.75; }

.ui-vote__confirm {
  margin-top: 32rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-pill);
  background: var(--c-brand);
  color: var(--c-on-strong);
  font-size: var(--fs-body);
  font-weight: 600;
  border: none;
  box-shadow: var(--sh-3);
}
.ui-vote__confirm::after { border: none; }
.ui-vote__confirm--off { background: var(--c-fill); color: var(--c-faint); box-shadow: none; }
.ui-vote__confirm--hover { opacity: 0.75; }

.ui-vote__meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--c-line);
  font-size: var(--fs-aux);
  color: var(--c-muted);
}
.ui-vote__meta-item { flex-shrink: 0; }
.ui-vote__meta-item--right { margin-left: auto; color: var(--c-faint); font-size: var(--fs-tag); }

.ui-vote__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ui-vote__action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-sunken);
  color: var(--c-muted);
  font-size: var(--fs-aux);
}
.ui-vote__action--hover { opacity: 0.72; }
.ui-vote__action--on { background: var(--c-brand-soft); color: var(--c-brand-deep); }
.ui-vote__action--right { margin-left: auto; }
.ui-vote__action-icon { width: 30rpx; height: 30rpx; }
