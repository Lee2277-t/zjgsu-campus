/* components/ui/sticky-filter/index.wxss */
.ui-sticky-filter {
  position: sticky;
  top: 0;
  z-index: 40;
  padding: 16rpx 0;
  background: var(--c-bg);
}

/* 毛玻璃降级方案：不用 backdrop-filter，靠高不透明度 + 描边近似。
   两个色都走令牌：以前这里写死 rgba(245,247,250,.94)，深色模式下
   整条筛选器仍是浅底，而里面的文字跟着 --c-muted 变浅 —— 浅底浅字，直接看不见。 */
.ui-sticky-filter--blur {
  background: var(--c-bg-blur);
  border-bottom: 2rpx solid var(--c-bg-blur-line);
}
