/* components/ui/base-card/index.wxss —— 外层卡片 32rpx 圆角 + 统一阴影 */
.ui-card {
  background: var(--c-card);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-1);
  margin-bottom: 24rpx;
}

.ui-card--padded { padding: 28rpx; }

.ui-card--flat {
  box-shadow: none;
  border: 2rpx solid var(--c-line);
}

.ui-card--flush {
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.ui-card--clickable {
  transition: opacity 0.15s ease, transform 0.12s ease;
}

.ui-card--hover {
  opacity: 0.72;
  transform: scale(0.988);
}
