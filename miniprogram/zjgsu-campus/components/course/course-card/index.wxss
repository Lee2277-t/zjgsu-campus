/* components/course/course-card/index.wxss
   课程卡：外层 32rpx 圆角 + 统一阴影（和 .card 同款），内层间距按 28rpx 走。
   所有文字都带 truncate/省略，320 宽度下课程名 + 学院 + 学分并存也不换行挤爆。 */
.cc {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--c-card);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-1);
  margin-bottom: 24rpx;
}

/* 首字母头像：6 色按 codePointAt(0) % 6 取，圆角 24rpx（对应 Web 的 rounded-inner） */
.cc__avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: var(--r-l);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-on-strong);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1;
}
.cc__avatar--0 { background: var(--c-brand); }
.cc__avatar--1 { background: var(--c-forum); }
.cc__avatar--2 { background: var(--c-market); }
.cc__avatar--3 { background: var(--c-campus); }
.cc__avatar--4 { background: var(--c-profile); }
.cc__avatar--5 { background: var(--c-danger); }

.cc__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cc__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.cc__title {
  flex: 1;
  min-width: 0;
}

.cc__name {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--c-text);
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cc__detail {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-aux);
  color: var(--c-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 有评分：琥珀底 + 琥珀数字 */
.cc__score {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  padding: 4rpx 16rpx;
  border-radius: var(--r-m);
  background: #fff7eb;
}
.cc__score-num {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--c-amber);
  line-height: 1.2;
}
.cc__score-unit {
  margin-left: 4rpx;
  font-size: var(--fs-micro);
  color: var(--c-amber);
}

/* 没评分：灰胶囊「暂无评分」，绝不显示 0.0 */
.cc__score-none {
  flex-shrink: 0;
  font-size: var(--fs-tag);
  color: var(--c-faint);
  background: var(--c-fill);
  border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
}

.cc__meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  min-width: 0;
}
.cc__meta-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.cc__meta-text {
  font-size: var(--fs-aux);
  color: var(--c-amber);
  flex-shrink: 0;
}
.cc__meta-text--muted { color: var(--c-muted); }
.cc__meta-diag { font-size: var(--fs-aux); color: var(--c-faint); flex-shrink: 0; }

/* 没评价的提示条：整行浅底，先告诉同学「这里将来会有东西」 */
.cc__cta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-l);
  background: var(--c-sunken);
}
.cc__cta-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}
.cc__cta-text {
  font-size: var(--fs-aux);
  color: var(--c-muted);
  line-height: 1.5;
}

.cc__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.cc__tag { line-height: 1.6; }
.cc__tag-none {
  font-size: var(--fs-tag);
  color: var(--c-faint);
}

.cc__arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-top: 12rpx;
}
